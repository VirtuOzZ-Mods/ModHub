<Application
  x:Class="GTAModManager.App.App"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:loc="clr-namespace:GTAModManager.App.Localization"
>
  <Application.Resources>
    <!-- Main UI font: Inter (SIL OFL 1.1, embedded in the assembly, no installation needed on other PCs). -->
    <FontFamily x:Key="UiFont">pack://application:,,,/Fonts/#Inter</FontFamily>

    <!-- Soft Touch: continuous satin gradients, fine rims and shallow depth.
             Resource names stay compatible with all existing views. No text-rasterizing effects. -->
    <Color x:Key="C.Bg">#1B1C1F</Color>
    <Color x:Key="C.Panel">#28292D</Color>
    <Color x:Key="C.Card">#303135</Color>
    <Color x:Key="C.CardHover">#424348</Color>
    <Color x:Key="C.Line">#4C4D52</Color>
    <Color x:Key="C.Accent">#FF991F</Color>
    <Color x:Key="C.AccentLight">#FFBC64</Color>
    <Color x:Key="C.AccentDark">#C87319</Color>
    <Color x:Key="C.Text">#F5F2ED</Color>
    <Color x:Key="C.Muted">#B8B5B0</Color>

    <SolidColorBrush x:Key="CardHover" Color="{StaticResource C.CardHover}" />
    <SolidColorBrush x:Key="Line" Color="{StaticResource C.Line}" />
    <SolidColorBrush x:Key="Accent" Color="{StaticResource C.Accent}" />
    <SolidColorBrush x:Key="AccentLight" Color="{StaticResource C.AccentLight}" />
    <SolidColorBrush x:Key="AccentDark" Color="{StaticResource C.AccentDark}" />
    <SolidColorBrush x:Key="Text" Color="{StaticResource C.Text}" />
    <SolidColorBrush x:Key="Muted" Color="{StaticResource C.Muted}" />
    <SolidColorBrush x:Key="Ok" Color="#66D6A0" />
    <SolidColorBrush x:Key="Warn" Color="#F5C66D" />
    <SolidColorBrush x:Key="Bad" Color="#F18383" />

    <LinearGradientBrush x:Key="Bg" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#202124" Offset="0" />
      <GradientStop Color="#1B1C1F" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Panel" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#303135" Offset="0" />
      <GradientStop Color="#28292D" Offset="0.45" />
      <GradientStop Color="#25262A" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Card" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#36373B" Offset="0" />
      <GradientStop Color="#303135" Offset="0.22" />
      <GradientStop Color="#2B2C30" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlossOrange" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#FFAF43" Offset="0" />
      <GradientStop Color="#FF9B24" Offset="0.3" />
      <GradientStop Color="#F58A12" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlossOrangeHover" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#FFBC60" Offset="0" />
      <GradientStop Color="#FFA638" Offset="0.35" />
      <GradientStop Color="#FF961F" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlossOrangePressed" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#CB6F0E" Offset="0" />
      <GradientStop Color="#E88417" Offset="0.45" />
      <GradientStop Color="#F0962A" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlossOrangeEdge" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#FFCC80" Offset="0" />
      <GradientStop Color="#E8A044" Offset="0.32" />
      <GradientStop Color="#9C591E" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlossDark" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#44454A" Offset="0" />
      <GradientStop Color="#38393E" Offset="0.23" />
      <GradientStop Color="#303136" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlossDarkHover" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#505156" Offset="0" />
      <GradientStop Color="#43444A" Offset="0.25" />
      <GradientStop Color="#393A40" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlossDarkPressed" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#27282C" Offset="0" />
      <GradientStop Color="#303136" Offset="0.65" />
      <GradientStop Color="#35363B" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BevelEdge" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#707075" Offset="0" />
      <GradientStop Color="#505156" Offset="0.25" />
      <GradientStop Color="#1A1B1E" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="InsetEdge" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#151619" Offset="0" />
      <GradientStop Color="#333438" Offset="0.5" />
      <GradientStop Color="#606066" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="InsetFill" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#26272B" Offset="0" />
      <GradientStop Color="#292A2E" Offset="0.3" />
      <GradientStop Color="#2D2E32" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SmokedGlass" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#3A3B40" Offset="0" />
      <GradientStop Color="#323338" Offset="0.15" />
      <GradientStop Color="#2C2D31" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SmokedEdge" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#69696E" Offset="0" />
      <GradientStop Color="#48494F" Offset="0.25" />
      <GradientStop Color="#1E1F22" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Sheen" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#10FFFFFF" Offset="0" />
      <GradientStop Color="#04FFFFFF" Offset="0.4" />
      <GradientStop Color="#00FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SoftSelection" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#53402C" Offset="0" />
      <GradientStop Color="#41372E" Offset="0.25" />
      <GradientStop Color="#35302D" Offset="1" />
    </LinearGradientBrush>

    <Style x:Key="SoftFocus" TargetType="Control">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Control">
            <Rectangle
              Margin="2"
              RadiusX="7"
              RadiusY="7"
              Stroke="{StaticResource AccentLight}"
              StrokeThickness="1"
              StrokeDashArray="2 2"
              IsHitTestVisible="False"
            />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Text}" />
      <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <!-- Text inside buttons, chips and tabs takes the element's own colour (otherwise the global TextBlock style
             paints everything white, which produced thin white text on orange buttons). -->
    <Style x:Key="InheritText" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
      <Setter
        Property="Foreground"
        Value="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource AncestorType=ContentPresenter}}"
      />
    </Style>

    <!-- Page titles: Bahnschrift, a dense technical grotesque shipped with Windows 10/11 (fallback: Segoe UI). -->
    <Style x:Key="PageTitle" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Bahnschrift SemiBold, Bahnschrift, Segoe UI" />
      <Setter Property="FontSize" Value="25" />
      <Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>

    <!-- Tooltips: dark (the global white TextBlock would otherwise give white on white). -->
    <Style TargetType="ToolTip">
      <Setter Property="Background" Value="{StaticResource SmokedGlass}" />
      <Setter Property="Foreground" Value="{StaticResource Text}" />
      <Setter Property="BorderBrush" Value="{StaticResource SmokedEdge}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="9,6" />
      <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToolTip">
            <Border
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}"
              CornerRadius="6"
              Padding="{TemplateBinding Padding}"
            >
              <ContentPresenter />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- The update bell uses a flat menu; system menu colors clash with our light TextBlock style. -->
    <Style x:Key="UpdatesMenuItem" TargetType="MenuItem">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource Text}" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="MenuItem">
            <Border
              x:Name="Row"
              Background="{TemplateBinding Background}"
              Padding="{TemplateBinding Padding}"
              CornerRadius="4"
            >
              <ContentPresenter
                ContentSource="Header"
                RecognizesAccessKey="True"
                TextElement.Foreground="{TemplateBinding Foreground}"
              />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Row" Property="Background" Value="{StaticResource CardHover}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource Muted}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="UpdatesMenu" TargetType="ContextMenu">
      <Setter Property="Background" Value="{StaticResource Card}" />
      <Setter Property="Foreground" Value="{StaticResource Text}" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="ItemContainerStyle" Value="{StaticResource UpdatesMenuItem}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ContextMenu">
            <Border
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}"
              CornerRadius="6"
              Padding="4"
            >
              <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto">
                <ItemsPresenter />
              </ScrollViewer>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button">
      <Setter Property="FocusVisualStyle" Value="{StaticResource SoftFocus}" />
      <Setter Property="Foreground" Value="#120C02" />
      <Setter Property="Background" Value="{StaticResource GlossOrange}" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Padding" Value="22,10" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="lip" CornerRadius="9" Background="#633C1D" Margin="0,2,0,-2">
                <Border.Effect>
                  <DropShadowEffect BlurRadius="5" ShadowDepth="1" Opacity="0.22" Color="#000000" />
                </Border.Effect>
              </Border>
              <Border
                x:Name="b"
                Background="{TemplateBinding Background}"
                BorderBrush="{StaticResource GlossOrangeEdge}"
                BorderThickness="1"
                CornerRadius="9"
              >
                <Grid>
                  <Border
                    x:Name="sheen"
                    CornerRadius="8,8,0,0"
                    Background="{StaticResource Sheen}"
                    Opacity="1"
                    IsHitTestVisible="False"
                  />
                  <ContentPresenter
                    TextElement.Foreground="{TemplateBinding Foreground}"
                    Margin="{TemplateBinding Padding}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                  >
                    <ContentPresenter.Resources>
                      <Style TargetType="TextBlock" BasedOn="{StaticResource InheritText}" />
                    </ContentPresenter.Resources>
                  </ContentPresenter>
                </Grid>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="{StaticResource GlossOrangeHover}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="b" Property="Background" Value="{StaticResource GlossOrangePressed}" />
                <Setter TargetName="b" Property="Margin" Value="0,1,0,-1" />
                <Setter TargetName="sheen" Property="Opacity" Value="0.15" />
                <Setter TargetName="lip" Property="Opacity" Value="0" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="b" Property="Background" Value="{StaticResource GlossDarkPressed}" />
                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Line}" />
                <Setter TargetName="sheen" Property="Opacity" Value="0.2" />
                <Setter TargetName="lip" Property="Opacity" Value="0" />
                <Setter Property="Foreground" Value="#A09D98" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Ghost" TargetType="Button">
      <Setter Property="FocusVisualStyle" Value="{StaticResource SoftFocus}" />
      <Setter Property="Foreground" Value="{StaticResource Text}" />
      <Setter Property="Background" Value="{StaticResource GlossDark}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="lip" CornerRadius="9" Background="#191A1D" Margin="0,2,0,-2">
                <Border.Effect>
                  <DropShadowEffect BlurRadius="5" ShadowDepth="1" Opacity="0.22" Color="#000000" />
                </Border.Effect>
              </Border>
              <Border
                x:Name="b"
                Background="{TemplateBinding Background}"
                BorderBrush="{StaticResource BevelEdge}"
                BorderThickness="1"
                CornerRadius="9"
              >
                <Grid>
                  <Border
                    x:Name="sheen"
                    CornerRadius="8,8,0,0"
                    Background="{StaticResource Sheen}"
                    Opacity="0.6"
                    IsHitTestVisible="False"
                  />
                  <ContentPresenter
                    TextElement.Foreground="{TemplateBinding Foreground}"
                    Margin="{TemplateBinding Padding}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                  >
                    <ContentPresenter.Resources>
                      <Style TargetType="TextBlock" BasedOn="{StaticResource InheritText}" />
                    </ContentPresenter.Resources>
                  </ContentPresenter>
                </Grid>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="{StaticResource GlossDarkHover}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="b" Property="Background" Value="{StaticResource GlossDarkPressed}" />
                <Setter TargetName="b" Property="Margin" Value="0,1,0,-1" />
                <Setter TargetName="sheen" Property="Opacity" Value="0.15" />
                <Setter TargetName="lip" Property="Opacity" Value="0" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="b" Property="Background" Value="{StaticResource GlossDarkPressed}" />
                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Line}" />
                <Setter TargetName="sheen" Property="Opacity" Value="0.2" />
                <Setter TargetName="lip" Property="Opacity" Value="0" />
                <Setter Property="Foreground" Value="#A09D98" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Game selection card / navigation item -->
    <Style x:Key="SideOption" TargetType="RadioButton">
      <Setter Property="FocusVisualStyle" Value="{StaticResource SoftFocus}" />
      <Setter Property="Foreground" Value="{StaticResource Text}" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Grid>
              <Border x:Name="lip" CornerRadius="11" Background="#191A1D" Margin="0,1.5,0,-1.5">
                <Border.Effect>
                  <DropShadowEffect BlurRadius="5" ShadowDepth="1" Opacity="0.22" Color="#000000" />
                </Border.Effect>
              </Border>
              <Border
                x:Name="b"
                Background="{StaticResource GlossDark}"
                CornerRadius="11"
                BorderThickness="1"
                BorderBrush="{StaticResource BevelEdge}"
              >
                <Grid>
                  <Border
                    x:Name="sheen"
                    CornerRadius="10,10,0,0"
                    Background="{StaticResource Sheen}"
                    Opacity="0.5"
                    IsHitTestVisible="False"
                  />
                  <Border
                    x:Name="led"
                    Width="4"
                    CornerRadius="2"
                    Margin="5,10"
                    HorizontalAlignment="Left"
                    Background="{StaticResource GlossOrange}"
                    Visibility="Collapsed"
                  />
                  <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" Margin="14,12">
                    <ContentPresenter.Resources>
                      <Style TargetType="TextBlock" BasedOn="{StaticResource InheritText}" />
                    </ContentPresenter.Resources>
                  </ContentPresenter>
                </Grid>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="{StaticResource GlossDarkHover}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource GlossOrangeEdge}" />
                <Setter TargetName="b" Property="BorderThickness" Value="1.5" />
                <Setter TargetName="led" Property="Visibility" Value="Visible" />
                <Setter TargetName="b" Property="Background" Value="{StaticResource SoftSelection}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="b" Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Flat GTA5-Mods wordmark plate: solid green, faint diagonal hatching, upright white "5MODS".
         The line box is fixed to the cap height so the caps sit in the optical center (Bahnschrift leaves
         descender room below, which otherwise pushes capitals up). Size follows FontSize. -->
    <Style x:Key="FiveModsPlate" TargetType="ContentControl">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ContentControl">
            <Border CornerRadius="3" Background="#24A83C" SnapsToDevicePixels="True" ClipToBounds="True">
              <Grid>
                <Rectangle Opacity="0.35">
                  <Rectangle.Fill>
                    <DrawingBrush TileMode="Tile" Viewport="0,0,6,6" ViewportUnits="Absolute" Stretch="None">
                      <DrawingBrush.Drawing>
                        <GeometryDrawing Geometry="M0,6 L6,0">
                          <GeometryDrawing.Pen>
                            <Pen Brush="#1C8F31" Thickness="1.4" />
                          </GeometryDrawing.Pen>
                        </GeometryDrawing>
                      </DrawingBrush.Drawing>
                    </DrawingBrush>
                  </Rectangle.Fill>
                </Rectangle>
                <TextBlock
                  Text="5MODS"
                  FontFamily="Bahnschrift, Segoe UI"
                  FontWeight="Bold"
                  FontSize="{TemplateBinding FontSize}"
                  Foreground="White"
                  LineStackingStrategy="BlockLineHeight"
                  LineHeight="{TemplateBinding FontSize}"
                  Margin="8,6,9,4"
                  VerticalAlignment="Center"
                />
              </Grid>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="CardBorder" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource SmokedGlass}" />
      <Setter Property="BorderBrush" Value="{StaticResource SmokedEdge}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="18" />
      <Setter Property="Margin" Value="0,0,0,14" />
    </Style>

    <!-- Scroll bars: thin, dark, accent colour while dragging -->
    <Style x:Key="ScrollThumb" TargetType="Thumb">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border
              x:Name="t"
              CornerRadius="4"
              Background="{StaticResource GlossDarkHover}"
              BorderBrush="{StaticResource BevelEdge}"
              BorderThickness="1"
            />
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="t" Property="Background" Value="#4A4E56" />
              </Trigger>
              <Trigger Property="IsDragging" Value="True">
                <Setter TargetName="t" Property="Background" Value="{StaticResource GlossOrange}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ScrollPage" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="IsTabStop" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Border Background="Transparent" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="10" />
      <Setter Property="MinWidth" Value="10" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Border Background="#14FFFFFF" CornerRadius="5" Margin="2,0,0,0">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageUpCommand" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Style="{StaticResource ScrollThumb}" Margin="1,1" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageDownCommand" />
                </Track.IncreaseRepeatButton>
              </Track>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Width" Value="Auto" />
          <Setter Property="MinWidth" Value="0" />
          <Setter Property="Height" Value="10" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ScrollBar">
                <Border Background="#14FFFFFF" CornerRadius="5" Margin="0,2,0,0">
                  <Track x:Name="PART_Track">
                    <Track.DecreaseRepeatButton>
                      <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageLeftCommand" />
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                      <Thumb Style="{StaticResource ScrollThumb}" Margin="1,1" />
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                      <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageRightCommand" />
                    </Track.IncreaseRepeatButton>
                  </Track>
                </Border>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- Window caption buttons -->
    <Style x:Key="CaptionButton" TargetType="Button">
      <Setter Property="Width" Value="46" />
      <Setter Property="Foreground" Value="{StaticResource Muted}" />
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="Transparent">
              <TextBlock
                Text="{TemplateBinding Content}"
                FontFamily="Segoe MDL2 Assets"
                FontSize="10"
                Foreground="{TemplateBinding Foreground}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
              />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="{StaticResource CardHover}" />
                <Setter Property="Foreground" Value="{StaticResource Text}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="Transparent">
              <TextBlock
                Text="{TemplateBinding Content}"
                FontFamily="Segoe MDL2 Assets"
                FontSize="10"
                Foreground="{TemplateBinding Foreground}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
              />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#E81123" />
                <Setter Property="Foreground" Value="White" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Tabs inside the package card -->
    <Style x:Key="TabOption" TargetType="RadioButton">
      <Setter Property="FocusVisualStyle" Value="{StaticResource SoftFocus}" />
      <Setter Property="Foreground" Value="{StaticResource Muted}" />
      <Setter Property="FontSize" Value="13.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Margin" Value="0,0,26,0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <StackPanel Background="Transparent">
              <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" Margin="0,12,0,10">
                <ContentPresenter.Resources>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource InheritText}" />
                </ContentPresenter.Resources>
              </ContentPresenter>
              <Border x:Name="u" Height="3" CornerRadius="1.5" Background="Transparent" />
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Text}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Text}" />
                <Setter TargetName="u" Property="Background" Value="{StaticResource GlossOrange}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="LinkButton" TargetType="Button">
      <Setter Property="FocusVisualStyle" Value="{StaticResource SoftFocus}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="#26000000" CornerRadius="6" Padding="10,5">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#40000000" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Override the system ComboBox chrome as well as its text: the Windows
             template otherwise keeps a light background under our white TextBlocks. -->
    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{StaticResource Text}" />
      <Setter Property="Background" Value="{StaticResource Card}" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border
              x:Name="ItemBorder"
              Background="{TemplateBinding Background}"
              Padding="{TemplateBinding Padding}"
              CornerRadius="4"
            >
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="ItemBorder" Property="Background" Value="#58432C" />
              </Trigger>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource CardHover}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ItemBorder" Property="Opacity" Value="0.55" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
      <Setter Property="Foreground" Value="{StaticResource Text}" />
      <Setter Property="Background" Value="{StaticResource GlossDark}" />
      <Setter Property="BorderBrush" Value="{StaticResource BevelEdge}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid x:Name="ComboRoot" SnapsToDevicePixels="True">
              <ToggleButton
                Focusable="False"
                ClickMode="Press"
                IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
              >
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border
                      Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                      BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                      BorderThickness="1"
                      CornerRadius="6"
                    >
                      <Path
                        Data="M 0 0 L 4 4 L 8 0"
                        Stroke="{StaticResource Text}"
                        StrokeThickness="1.5"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,12,0"
                      />
                    </Border>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter
                Content="{TemplateBinding SelectionBoxItem}"
                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                Margin="10,5,32,5"
                IsHitTestVisible="False"
              />
              <Popup
                x:Name="PART_Popup"
                IsOpen="{TemplateBinding IsDropDownOpen}"
                Placement="Bottom"
                AllowsTransparency="True"
                Focusable="False"
                PopupAnimation="Fade"
              >
                <Border
                  Background="{StaticResource SmokedGlass}"
                  BorderBrush="{StaticResource SmokedEdge}"
                  BorderThickness="1"
                  CornerRadius="8"
                  Padding="4"
                  MinWidth="{TemplateBinding ActualWidth}"
                >
                  <ScrollViewer
                    MaxHeight="260"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                  >
                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ComboRoot" Property="Opacity" Value="0.55" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Background" Value="{StaticResource InsetFill}" />
      <Setter Property="Foreground" Value="{StaticResource Text}" />
      <Setter Property="CaretBrush" Value="{StaticResource Accent}" />
      <Setter Property="SelectionBrush" Value="{StaticResource Accent}" />
      <Setter Property="FontSize" Value="13.5" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border
              x:Name="b"
              Background="{TemplateBinding Background}"
              BorderBrush="{StaticResource InsetEdge}"
              BorderThickness="1"
              CornerRadius="9"
            >
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="b" Property="Opacity" Value="0.5" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="UnitChip" TargetType="RadioButton">
      <Setter Property="FocusVisualStyle" Value="{StaticResource SoftFocus}" />
      <Setter Property="Foreground" Value="{StaticResource Text}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Margin" Value="6,0,0,0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border
              x:Name="b"
              Background="{StaticResource GlossDark}"
              BorderBrush="{StaticResource BevelEdge}"
              BorderThickness="1"
              CornerRadius="8"
              Padding="14,7"
            >
              <ContentPresenter
                TextElement.Foreground="{TemplateBinding Foreground}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
              >
                <ContentPresenter.Resources>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource InheritText}" />
                </ContentPresenter.Resources>
              </ContentPresenter>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="{StaticResource GlossDarkHover}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="b" Property="Background" Value="{StaticResource GlossOrange}" />
                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource GlossOrangeEdge}" />
                <Setter Property="Foreground" Value="#120C02" />
                <Setter Property="FontWeight" Value="Bold" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ModToggle" TargetType="ToggleButton">
      <Setter Property="FocusVisualStyle" Value="{StaticResource SoftFocus}" />
      <Setter Property="Foreground" Value="{StaticResource Text}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border
              x:Name="b"
              Background="{StaticResource GlossDark}"
              BorderBrush="{StaticResource BevelEdge}"
              BorderThickness="1"
              CornerRadius="8"
              Padding="{TemplateBinding Padding}"
            >
              <ContentPresenter
                TextElement.Foreground="{TemplateBinding Foreground}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
              >
                <ContentPresenter.Resources>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource InheritText}" />
                </ContentPresenter.Resources>
              </ContentPresenter>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="{StaticResource GlossDarkHover}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="b" Property="Background" Value="{StaticResource GlossOrange}" />
                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource GlossOrangeEdge}" />
                <Setter Property="Foreground" Value="#120C02" />
                <Setter Property="FontWeight" Value="Bold" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Check box: recessed socket; when checked, a glossy orange button with a dark tick. -->
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Text}" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Background="Transparent">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border
                x:Name="box"
                Width="18"
                Height="18"
                CornerRadius="5"
                VerticalAlignment="Center"
                Background="{StaticResource InsetFill}"
                BorderBrush="{StaticResource InsetEdge}"
                BorderThickness="1"
              >
                <Path
                  x:Name="tick"
                  Data="M 3.5,9 L 7.5,13 L 14,5"
                  Stroke="#1A1206"
                  StrokeThickness="2.4"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  StrokeLineJoin="Round"
                  Visibility="Collapsed"
                />
              </Border>
              <ContentPresenter
                TextElement.Foreground="{TemplateBinding Foreground}"
                Grid.Column="1"
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                RecognizesAccessKey="True"
              >
                <ContentPresenter.Resources>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource InheritText}" />
                </ContentPresenter.Resources>
              </ContentPresenter>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource GlossOrangeEdge}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="box" Property="Background" Value="{StaticResource GlossOrange}" />
                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource GlossOrangeEdge}" />
                <Setter TargetName="tick" Property="Visibility" Value="Visible" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ListBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{StaticResource Text}" />
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <ContentPresenter />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Application.Resources>
</Application>
