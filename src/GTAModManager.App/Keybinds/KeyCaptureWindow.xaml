<Window
  x:Class="GTAModManager.App.Keybinds.KeyCaptureWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="{loc:Tr ui.keybinds.changeKey}"
  Icon="/app.ico"
  Width="900"
  SizeToContent="Height"
  ResizeMode="NoResize"
  Background="{StaticResource Bg}"
  WindowStartupLocation="CenterOwner"
  ShowInTaskbar="False"
  PreviewKeyDown="OnPreviewKeyDown"
  xmlns:loc="clr-namespace:GTAModManager.App.Localization"
>
  <WindowChrome.WindowChrome>
    <WindowChrome
      CaptionHeight="40"
      ResizeBorderThickness="0"
      GlassFrameThickness="0"
      CornerRadius="0"
      UseAeroCaptionButtons="False"
    />
  </WindowChrome.WindowChrome>
  <Border BorderBrush="{StaticResource Line}" BorderThickness="1">
    <StackPanel>
      <Border
        Background="{StaticResource Panel}"
        Height="40"
        BorderBrush="{StaticResource Line}"
        BorderThickness="0,0,0,1"
      >
        <DockPanel>
          <Button DockPanel.Dock="Right" Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="OnCancel" />
          <TextBlock
            Text="{loc:Tr ui.keybinds.changeKey}"
            FontWeight="SemiBold"
            VerticalAlignment="Center"
            Margin="16,0,0,0"
          />
        </DockPanel>
      </Border>

      <StackPanel Margin="22,18,22,20">
        <TextBlock x:Name="EntryTitle" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock x:Name="EntryInfo" Foreground="{StaticResource Muted}" Margin="0,4,0,14" TextWrapping="Wrap" />

        <Border Background="#0B0B0B" CornerRadius="10" Padding="16,12" Margin="0,0,0,12">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <ToggleButton
                x:Name="CtrlToggle"
                Content="{loc:Tr ui.keybinds.ctrl}"
                Click="OnModifierToggle"
                Margin="0,0,6,0"
                Padding="12,6"
              />
              <ToggleButton
                x:Name="ShiftToggle"
                Content="{loc:Tr ui.keybinds.shift}"
                Click="OnModifierToggle"
                Margin="0,0,6,0"
                Padding="12,6"
              />
              <ToggleButton
                x:Name="AltToggle"
                Content="{loc:Tr ui.keybinds.alt}"
                Click="OnModifierToggle"
                Padding="12,6"
              />
            </StackPanel>
            <StackPanel>
              <TextBlock
                Text="{loc:Tr ui.keybinds.pressNewKeyKeyboardShortcut}"
                Foreground="{StaticResource Muted}"
                FontSize="12"
                TextWrapping="Wrap"
              />
              <TextBlock Margin="0,6,0,0" FontSize="20" FontWeight="Bold">
                <Run x:Name="OldChord" Foreground="{StaticResource Muted}" />
                <Run Text="  →  " Foreground="{StaticResource Muted}" />
                <Run x:Name="NewChord" Foreground="{StaticResource Accent}" />
              </TextBlock>
            </StackPanel>
          </DockPanel>
        </Border>

        <ContentControl x:Name="KeyboardHost" Height="230" Margin="0,0,0,12" />

        <WrapPanel x:Name="Suggestions" Margin="0,0,0,10" />

        <Border Background="{StaticResource Card}" CornerRadius="10" Padding="14,10">
          <StackPanel>
            <TextBlock x:Name="PreviewText" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12.5" />
            <TextBlock x:Name="ErrorText" Foreground="{StaticResource Bad}" TextWrapping="Wrap" Margin="0,4,0,0" />
            <ItemsControl x:Name="ConflictList" Margin="0,4,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock
                    Text="{Binding Text}"
                    Foreground="{Binding Brush}"
                    TextWrapping="Wrap"
                    FontSize="12"
                    Margin="0,2,0,0"
                  />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <DockPanel Margin="0,16,0,0">
          <Button
            DockPanel.Dock="Right"
            x:Name="SaveButton"
            Content="{loc:Tr ui.common.save}"
            Style="{StaticResource Primary}"
            MinWidth="150"
            IsEnabled="False"
            Click="OnSave"
          />
          <Button
            DockPanel.Dock="Right"
            Content="{loc:Tr ui.common.cancel}"
            Style="{StaticResource Ghost}"
            Margin="0,0,10,0"
            Click="OnCancel"
          />
          <TextBlock
            Text="{loc:Tr ui.keybinds.fileBackedUpBeforeWriting}"
            Foreground="{StaticResource Muted}"
            FontSize="12"
            TextWrapping="Wrap"
            VerticalAlignment="Center"
            Margin="0,0,12,0"
          />
        </DockPanel>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
