<UserControl
  x:Class="GTAModManager.App.Discover.DiscoverPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:loc="clr-namespace:GTAModManager.App.Localization"
>
  <UserControl.Resources>
    <!-- Skeleton: soft pulse while the cover and stats are loading -->
    <Storyboard x:Key="Pulse" RepeatBehavior="Forever" AutoReverse="True">
      <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.35" To="0.8" Duration="0:0:0.9" />
    </Storyboard>
    <Style x:Key="Skeleton" TargetType="Border">
      <Setter Property="Background" Value="#262626" />
      <Style.Triggers>
        <Trigger Property="IsVisible" Value="True">
          <Trigger.EnterActions>
            <BeginStoryboard Storyboard="{StaticResource Pulse}" />
          </Trigger.EnterActions>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="Badge" TargetType="Border">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="8,2,8,3" />
      <Setter Property="Margin" Value="0,0,6,0" />
    </Style>
    <Style x:Key="LinkButton" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border
              x:Name="b"
              Background="{StaticResource GlossDark}"
              BorderBrush="{StaticResource BevelEdge}"
              BorderThickness="1"
              CornerRadius="8"
              Padding="8,4"
              Margin="0,0,6,0"
            >
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="{StaticResource GlossDarkHover}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Header -->
    <DockPanel Margin="0,0,0,12">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
        <TextBlock
          x:Name="StatusText"
          Foreground="{StaticResource Muted}"
          FontSize="12"
          VerticalAlignment="Center"
          Margin="0,0,12,0"
          TextWrapping="Wrap"
          MaxWidth="360"
          TextAlignment="Right"
        />
        <Button
          x:Name="RefreshButton"
          Content="{loc:Tr ui.common.refresh}"
          Style="{StaticResource Primary}"
          Click="OnRefresh"
          ToolTip="{loc:Tr ui.discover.refreshCoversStatisticsFromMod}"
        />
      </StackPanel>
      <StackPanel>
        <TextBlock Text="{loc:Tr ui.common.recommendations}" Style="{StaticResource PageTitle}" />
        <TextBlock
          Text="{loc:Tr ui.discover.selectionVerifiedModsToolsEach}"
          Foreground="{StaticResource Muted}"
          Margin="0,3,0,0"
          TextWrapping="Wrap"
        />
      </StackPanel>
    </DockPanel>

    <!-- Categories -->
    <StackPanel Grid.Row="1" x:Name="CategoryTabs" Orientation="Horizontal" Margin="0,0,0,12" />

    <!-- VirtuOzZ collection header / category description -->
    <Border Grid.Row="2" x:Name="Hero" CornerRadius="14" Padding="22,18" Margin="0,0,0,12" Visibility="Collapsed">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Color="#3A2300" Offset="0" />
          <GradientStop Color="#22252A" Offset="0.55" />
          <GradientStop Color="#181A1E" Offset="1" />
        </LinearGradientBrush>
      </Border.Background>
      <DockPanel>
        <Grid DockPanel.Dock="Left" Width="72" Height="72" Margin="0,0,18,0" VerticalAlignment="Center">
          <!-- Author avatar (GTA5-Mods, VirtuOzZ) in a glossy orange frame -->
          <Border
            CornerRadius="16"
            Background="{StaticResource GlossOrange}"
            BorderBrush="{StaticResource GlossOrangeEdge}"
            BorderThickness="1"
          />
          <Border CornerRadius="13" Margin="3">
            <Border.Background>
              <ImageBrush
                ImageSource="/Discover/Assets/virtuozz-avatar.png"
                Stretch="UniformToFill"
                RenderOptions.BitmapScalingMode="HighQuality"
              />
            </Border.Background>
          </Border>
        </Grid>
        <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="HeroTitle" FontFamily="Bahnschrift SemiBold, Bahnschrift, Segoe UI" FontSize="28" />
          <TextBlock x:Name="HeroText" Foreground="#CFCFCF" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>
      </DockPanel>
    </Border>
    <TextBlock
      Grid.Row="2"
      x:Name="CategoryText"
      Foreground="{StaticResource Muted}"
      Margin="0,0,0,12"
      TextWrapping="Wrap"
    />

    <!-- Search, edition, sorting; card editor buttons on editable tabs -->
    <WrapPanel Grid.Row="3" Margin="0,0,0,12">
      <StackPanel x:Name="EditorBar" Orientation="Horizontal" Margin="0,0,14,6" Visibility="Collapsed">
        <Button
          x:Name="AddCardButton"
          Content="{loc:Tr ui.discover.addModFromGta5Mods}"
          Style="{StaticResource Primary}"
          Click="OnAddCardClick"
          ToolTip="{loc:Tr ui.discover.addModFromGta5ModsTip}"
        />
        <Button
          x:Name="EditListButton"
          Style="{StaticResource Ghost}"
          Margin="8,0,0,0"
          Click="OnEditListClick"
          ToolTip="{loc:Tr ui.discover.editListTip}"
        />
        <Button
          x:Name="ExportButton"
          Content="{loc:Tr ui.discover.exportToCatalog}"
          Style="{StaticResource Ghost}"
          Margin="8,0,0,0"
          Click="OnExportClick"
          ToolTip="{loc:Tr ui.discover.exportToCatalogTip}"
        />
        <Button
          x:Name="RestoreHiddenButton"
          Style="{StaticResource Ghost}"
          Margin="8,0,0,0"
          Click="OnRestoreHiddenClick"
          ToolTip="{loc:Tr ui.discover.restoreHiddenTip}"
          Visibility="Collapsed"
        />
      </StackPanel>
      <Grid Width="260" Margin="0,0,14,6">
        <TextBox
          x:Name="SearchBox"
          TextChanged="OnSearchChanged"
          GotKeyboardFocus="OnSearchFocus"
          LostKeyboardFocus="OnSearchFocus"
        />
        <TextBlock
          x:Name="SearchHint"
          Text="{loc:Tr ui.discover.searchByName}"
          Foreground="{StaticResource Muted}"
          IsHitTestVisible="False"
          VerticalAlignment="Center"
          Margin="12,0,0,0"
        />
      </Grid>
      <StackPanel x:Name="EditionChips" Orientation="Horizontal" Margin="0,0,14,6" VerticalAlignment="Center" />
      <StackPanel x:Name="SortChips" Orientation="Horizontal" Margin="0,0,0,6" VerticalAlignment="Center" />
    </WrapPanel>

    <!-- Card grid -->
    <ScrollViewer
      Grid.Row="4"
      x:Name="Scroller"
      VerticalScrollBarVisibility="Auto"
      HorizontalScrollBarVisibility="Disabled"
      SizeChanged="OnScrollerSizeChanged"
    >
      <StackPanel>
        <ItemsControl x:Name="Cards" Margin="0,4,-16,0">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid
                Columns="{Binding Columns, RelativeSource={RelativeSource AncestorType=UserControl}}"
                VerticalAlignment="Top"
              />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <!-- The highlight is a separate layer under the card: an effect (shadow) or scaling on the card itself
                                 rasterizes its content and the text turns blurry. -->
              <Grid Margin="0,0,16,16">
                <Border x:Name="Glow" Background="#1B1D21" CornerRadius="16">
                  <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0" Color="#FF9900" />
                  </Border.Effect>
                </Border>
                <Border
                  x:Name="Card"
                  Background="{StaticResource SmokedGlass}"
                  CornerRadius="16"
                  BorderBrush="#3A3D43"
                  BorderThickness="1"
                  Cursor="Hand"
                  Tag="{Binding}"
                  MouseLeftButtonUp="OnCardClick"
                  ToolTip="{Binding Entry.Url}"
                >
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="176" />
                      <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Cover: aspect-preserving crop, rounded top corners -->
                    <Border CornerRadius="15,15,0,0" Background="#1B1D21" ClipToBounds="True">
                      <Grid>
                        <Border CornerRadius="13,13,0,0">
                          <Border.Background>
                            <ImageBrush
                              ImageSource="{Binding Cover}"
                              Stretch="{Binding CoverStretch}"
                              AlignmentY="Center"
                            />
                          </Border.Background>
                        </Border>
                        <Border
                          CornerRadius="13,13,0,0"
                          Style="{StaticResource Skeleton}"
                          Visibility="{Binding SkeletonVisibility}"
                        />
                        <Border CornerRadius="13,13,0,0" Visibility="{Binding PlaceholderVisibility}">
                          <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                              <GradientStop Color="#30333A" Offset="0" />
                              <GradientStop Color="#1B1D21" Offset="1" />
                            </LinearGradientBrush>
                          </Border.Background>
                          <TextBlock
                            Text="{Binding Initials}"
                            FontFamily="Bahnschrift, Segoe UI"
                            FontSize="46"
                            FontWeight="Bold"
                            Foreground="#454952"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                          />
                        </Border>
                        <!-- Bottom fade and badges -->
                        <Border CornerRadius="13,13,0,0" IsHitTestVisible="False">
                          <Border.Background>
                            <LinearGradientBrush StartPoint="0,0.55" EndPoint="0,1">
                              <GradientStop Color="#00000000" Offset="0" />
                              <GradientStop Color="#C01F2226" Offset="1" />
                            </LinearGradientBrush>
                          </Border.Background>
                        </Border>
                        <StackPanel
                          Orientation="Horizontal"
                          VerticalAlignment="Top"
                          HorizontalAlignment="Left"
                          Margin="10"
                        >
                          <Border
                            Style="{StaticResource Badge}"
                            Background="{StaticResource GlossDark}"
                            BorderBrush="{StaticResource BevelEdge}"
                            BorderThickness="1"
                            Visibility="{Binding LegacyVisibility}"
                            ToolTip="{loc:Tr ui.discover.gtaVLegacySupportConfirmed}"
                          >
                            <TextBlock
                              Text="{loc:Tr ui.discover.legacy}"
                              FontSize="11"
                              FontWeight="SemiBold"
                              Foreground="#FFFFFF"
                            />
                          </Border>
                          <Border
                            Style="{StaticResource Badge}"
                            Background="{StaticResource GlossOrange}"
                            BorderBrush="{StaticResource GlossOrangeEdge}"
                            BorderThickness="1"
                            Visibility="{Binding EnhancedVisibility}"
                            ToolTip="{loc:Tr ui.discover.gtaVEnhancedSupportConfirmed}"
                          >
                            <TextBlock
                              Text="{loc:Tr ui.discover.enhanced}"
                              FontSize="11"
                              FontWeight="Bold"
                              Foreground="#120C02"
                            />
                          </Border>
                          <Border
                            Style="{StaticResource Badge}"
                            Background="#CC3A3D43"
                            BorderBrush="{StaticResource BevelEdge}"
                            BorderThickness="1"
                            Visibility="{Binding UnsureVisibility}"
                            ToolTip="{loc:Tr ui.discover.notSureEditionTip}"
                          >
                            <TextBlock
                              Text="{loc:Tr ui.discover.editionNotSureBadge}"
                              FontSize="11"
                              FontWeight="SemiBold"
                              Foreground="#FFD27A"
                            />
                          </Border>
                        </StackPanel>
                        <Border
                          Style="{StaticResource Badge}"
                          Background="{Binding StatusBrush}"
                          VerticalAlignment="Top"
                          HorizontalAlignment="Left"
                          Margin="10"
                          Visibility="{Binding StatusVisibility}"
                        >
                          <TextBlock
                            Text="{Binding StatusText}"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="White"
                          />
                        </Border>
                        <Border
                          Style="{StaticResource Badge}"
                          Background="#CC000000"
                          VerticalAlignment="Top"
                          HorizontalAlignment="Right"
                          Margin="10"
                          Visibility="{Binding KindVisibility}"
                        >
                          <TextBlock Text="{Binding Kind}" FontSize="11" Foreground="#DDDDDD" />
                        </Border>
                      </Grid>
                    </Border>

                    <!-- Card text -->
                    <StackPanel Grid.Row="1" Margin="14,12,14,14">
                      <TextBlock
                        Text="{Binding Title}"
                        FontFamily="Bahnschrift SemiBold, Bahnschrift, Segoe UI"
                        FontSize="16.5"
                        TextWrapping="Wrap"
                        MaxHeight="44"
                        TextTrimming="CharacterEllipsis"
                      />
                      <DockPanel Margin="0,3,0,0">
                        <TextBlock
                          DockPanel.Dock="Right"
                          Text="{Binding VersionText}"
                          Visibility="{Binding VersionVisibility}"
                          Foreground="{StaticResource Accent}"
                          FontSize="12"
                          Margin="8,0,0,0"
                          MaxWidth="170"
                          TextTrimming="CharacterEllipsis"
                          ToolTip="{Binding VersionText}"
                        />
                        <Ellipse
                          Width="18"
                          Height="18"
                          Margin="0,0,6,0"
                          VerticalAlignment="Center"
                          Visibility="{Binding AvatarVisibility}"
                        >
                          <Ellipse.Fill>
                            <ImageBrush ImageSource="{Binding Avatar}" Stretch="UniformToFill" />
                          </Ellipse.Fill>
                        </Ellipse>
                        <TextBlock
                          VerticalAlignment="Center"
                          Text="{Binding AuthorText}"
                          Foreground="{StaticResource Muted}"
                          FontSize="12.5"
                          TextTrimming="CharacterEllipsis"
                        />
                      </DockPanel>
                      <TextBlock
                        Text="{Binding ShvdnText}"
                        Visibility="{Binding ShvdnVisibility}"
                        Foreground="{StaticResource Muted}"
                        FontSize="11.5"
                        TextWrapping="Wrap"
                        Margin="0,4,0,0"
                      />

                      <!-- Stats -->
                      <StackPanel Margin="0,10,0,0" Visibility="{Binding StatsVisibility}" ToolTip="{Binding StatsTip}">
                        <StackPanel Orientation="Horizontal">
                          <Grid Width="72" VerticalAlignment="Center">
                            <TextBlock Text="★★★★★" FontSize="13.5" Foreground="#3A3D43" Width="72" />
                            <Border HorizontalAlignment="Left" Width="{Binding StarsWidth}" ClipToBounds="True">
                              <TextBlock
                                Text="★★★★★"
                                FontSize="13.5"
                                Foreground="{StaticResource AccentLight}"
                                Width="72"
                              />
                            </Border>
                          </Grid>
                          <TextBlock
                            Text="{Binding RatingText}"
                            FontWeight="SemiBold"
                            FontSize="12.5"
                            Margin="6,0,3,0"
                            VerticalAlignment="Center"
                          />
                          <TextBlock
                            Text="{Binding VotesText}"
                            Foreground="{StaticResource Muted}"
                            FontSize="12"
                            VerticalAlignment="Center"
                          />
                        </StackPanel>
                        <UniformGrid Columns="3" Margin="0,8,0,0">
                          <StackPanel Orientation="Horizontal">
                            <TextBlock
                              Text="&#xE8E1;"
                              FontFamily="Segoe MDL2 Assets"
                              Foreground="{StaticResource Muted}"
                              FontSize="12"
                              VerticalAlignment="Center"
                              Margin="0,0,5,0"
                            />
                            <TextBlock Text="{Binding LikesText}" FontSize="12" VerticalAlignment="Center" />
                          </StackPanel>
                          <StackPanel Orientation="Horizontal">
                            <TextBlock
                              Text="&#xE896;"
                              FontFamily="Segoe MDL2 Assets"
                              Foreground="{StaticResource Muted}"
                              FontSize="12"
                              VerticalAlignment="Center"
                              Margin="0,0,5,0"
                            />
                            <TextBlock Text="{Binding DownloadsText}" FontSize="12" VerticalAlignment="Center" />
                          </StackPanel>
                          <StackPanel Orientation="Horizontal">
                            <TextBlock
                              Text="&#xE8BD;"
                              FontFamily="Segoe MDL2 Assets"
                              Foreground="{StaticResource Muted}"
                              FontSize="12"
                              VerticalAlignment="Center"
                              Margin="0,0,5,0"
                            />
                            <TextBlock Text="{Binding CommentsText}" FontSize="12" VerticalAlignment="Center" />
                          </StackPanel>
                        </UniformGrid>
                      </StackPanel>
                      <StackPanel Margin="0,10,0,0" Visibility="{Binding StatsSkeletonVisibility}">
                        <Border
                          Style="{StaticResource Skeleton}"
                          Height="12"
                          Width="140"
                          CornerRadius="4"
                          HorizontalAlignment="Left"
                        />
                        <Border Style="{StaticResource Skeleton}" Height="12" CornerRadius="4" Margin="0,9,30,0" />
                      </StackPanel>
                      <TextBlock
                        Text="{Binding NoStatsText}"
                        Visibility="{Binding NoStatsVisibility}"
                        Foreground="{StaticResource Muted}"
                        FontSize="12"
                        Margin="0,10,0,0"
                      />

                      <TextBlock
                        Text="{Binding Note}"
                        Visibility="{Binding NoteVisibility}"
                        Foreground="#CDBA8A"
                        FontSize="11.5"
                        TextWrapping="Wrap"
                        Margin="0,8,0,0"
                      />

                      <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="8" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button
                          Style="{StaticResource Ghost}"
                          Tag="{Binding}"
                          Click="OnOpenPageClick"
                          ToolTip="{Binding Entry.Url}"
                          Padding="10,6"
                          FontSize="12.5"
                        >
                          <!-- GTA5-Mods pages read "Open on [5MODS]": the plate makes the destination obvious. -->
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding PageButtonText}" VerticalAlignment="Center" />
                            <ContentControl
                              Style="{StaticResource FiveModsPlate}"
                              FontSize="11.5"
                              Margin="6,0,0,0"
                              VerticalAlignment="Center"
                              Visibility="{Binding Gta5ModsPlateVisibility}"
                            />
                          </StackPanel>
                        </Button>
                        <Button
                          Grid.Column="2"
                          Style="{StaticResource Primary}"
                          Content="{Binding InstallText}"
                          Tag="{Binding}"
                          Click="OnInstallClick"
                          IsEnabled="{Binding InstallEnabled}"
                          Visibility="{Binding InstallVisibility}"
                          ToolTip="{Binding InstallTip}"
                          Padding="14,6"
                          FontSize="12.5"
                          MinWidth="110"
                        />
                      </Grid>

                      <DockPanel Margin="0,10,0,0">
                        <TextBlock
                          DockPanel.Dock="Right"
                          Text="{Binding UpdatedText}"
                          Foreground="#6E6E6E"
                          FontSize="11"
                          VerticalAlignment="Center"
                        />
                        <ItemsControl ItemsSource="{Binding Links}" Visibility="{Binding LinksVisibility}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <WrapPanel />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Button
                                Style="{StaticResource LinkButton}"
                                Tag="{Binding Url}"
                                Click="OnLinkClick"
                                ToolTip="{Binding Tip}"
                              >
                                <StackPanel Orientation="Horizontal">
                                  <Border
                                    Width="8"
                                    Height="8"
                                    CornerRadius="4"
                                    Background="{Binding Brush}"
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center"
                                  />
                                  <TextBlock Text="{Binding Label}" FontSize="11.5" VerticalAlignment="Center" />
                                </StackPanel>
                              </Button>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </DockPanel>

                      <!-- List editing (after "Edit list"): hand-set order, edit a custom card, remove the card -->
                      <Border
                        Margin="0,12,0,0"
                        Padding="0,10,0,0"
                        BorderBrush="#3A3D43"
                        BorderThickness="0,1,0,0"
                        Visibility="{Binding ToolsVisibility}"
                      >
                        <DockPanel LastChildFill="False">
                          <StackPanel
                            DockPanel.Dock="Left"
                            Orientation="Horizontal"
                            Visibility="{Binding ReorderVisibility}"
                          >
                            <Button
                              Style="{StaticResource LinkButton}"
                              Tag="{Binding}"
                              Click="OnMoveEarlierClick"
                              ToolTip="{loc:Tr ui.discover.moveEarlier}"
                            >
                              <TextBlock Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="12" />
                            </Button>
                            <TextBlock
                              Text="{Binding Position}"
                              FontSize="12"
                              FontWeight="SemiBold"
                              Foreground="#FFB43C"
                              MinWidth="18"
                              Margin="0,0,6,0"
                              TextAlignment="Center"
                              VerticalAlignment="Center"
                              ToolTip="{loc:Tr ui.discover.positionTip}"
                            />
                            <Button
                              Style="{StaticResource LinkButton}"
                              Tag="{Binding}"
                              Click="OnMoveLaterClick"
                              ToolTip="{loc:Tr ui.discover.moveLater}"
                            >
                              <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="12" />
                            </Button>
                          </StackPanel>
                          <Button
                            DockPanel.Dock="Right"
                            Style="{StaticResource LinkButton}"
                            Tag="{Binding}"
                            Click="OnDeleteCardClick"
                            ToolTip="{loc:Tr ui.discover.deleteCardTip}"
                            Visibility="{Binding DeleteVisibility}"
                          >
                            <StackPanel Orientation="Horizontal">
                              <TextBlock
                                Text="&#xE74D;"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="12"
                                Foreground="#FF7A6E"
                                VerticalAlignment="Center"
                              />
                              <TextBlock
                                Text="{loc:Tr ui.discover.deleteCard}"
                                FontSize="11.5"
                                Margin="5,0,0,0"
                                Foreground="#FF9B91"
                                VerticalAlignment="Center"
                              />
                            </StackPanel>
                          </Button>
                          <Button
                            DockPanel.Dock="Right"
                            Style="{StaticResource LinkButton}"
                            Tag="{Binding}"
                            Click="OnEditCardClick"
                            ToolTip="{loc:Tr ui.discover.editCard}"
                            Visibility="{Binding EditVisibility}"
                          >
                            <StackPanel Orientation="Horizontal">
                              <TextBlock
                                Text="&#xE70F;"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="12"
                                VerticalAlignment="Center"
                              />
                              <TextBlock
                                Text="{loc:Tr ui.discover.editShort}"
                                FontSize="11.5"
                                Margin="5,0,0,0"
                                VerticalAlignment="Center"
                              />
                            </StackPanel>
                          </Button>
                        </DockPanel>
                      </Border>
                    </StackPanel>
                  </Grid>
                </Border>
              </Grid>
              <DataTemplate.Triggers>
                <EventTrigger SourceName="Card" RoutedEvent="MouseEnter">
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation
                        Storyboard.TargetName="Glow"
                        Storyboard.TargetProperty="Effect.Opacity"
                        To="0.35"
                        Duration="0:0:0.15"
                      />
                      <ColorAnimation
                        Storyboard.TargetName="Card"
                        Storyboard.TargetProperty="BorderBrush.Color"
                        To="#FF9900"
                        Duration="0:0:0.15"
                      />
                    </Storyboard>
                  </BeginStoryboard>
                </EventTrigger>
                <EventTrigger SourceName="Card" RoutedEvent="MouseLeave">
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation
                        Storyboard.TargetName="Glow"
                        Storyboard.TargetProperty="Effect.Opacity"
                        To="0"
                        Duration="0:0:0.2"
                      />
                      <ColorAnimation
                        Storyboard.TargetName="Card"
                        Storyboard.TargetProperty="BorderBrush.Color"
                        To="#3A3D43"
                        Duration="0:0:0.2"
                      />
                    </Storyboard>
                  </BeginStoryboard>
                </EventTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock
          x:Name="EmptyText"
          Foreground="{StaticResource Muted}"
          Margin="0,24,0,0"
          HorizontalAlignment="Center"
          TextWrapping="Wrap"
          Visibility="Collapsed"
        />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
