<UserControl
  x:Class="GTAModManager.App.Peds.PedsPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:loc="clr-namespace:GTAModManager.App.Localization"
>
  <UserControl.Resources>
    <!-- Round translucent arrow over the photo -->
    <Style x:Key="GalleryArrow" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Width="30" Height="30" CornerRadius="15" Background="#99000000">
              <TextBlock
                Text="{TemplateBinding Content}"
                FontFamily="Segoe MDL2 Assets"
                FontSize="12"
                Foreground="White"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
              />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#E6FF9900" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>
  <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="0,0,12,20">
      <DockPanel Margin="0,0,0,12">
        <Button
          DockPanel.Dock="Right"
          Style="{StaticResource Ghost}"
          Click="OnRefresh"
          Padding="10,6"
          ToolTip="{loc:Tr ui.peds.reloadInstalledCharacterList}"
        >
          <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="13" />
        </Button>
        <TextBlock Text="{loc:Tr ui.common.addCharacters}" Style="{StaticResource PageTitle}" />
      </DockPanel>
      <TextBlock x:Name="Status" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,12" />
      <StackPanel x:Name="LegacyContent">
        <!-- Tabs: adding characters and the collection of installed characters -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
          <RadioButton
            x:Name="AddTab"
            Style="{StaticResource TabOption}"
            GroupName="pedstab"
            IsChecked="True"
            Checked="OnPedsTab"
            Content="{loc:Tr ui.peds.addCharacters}"
          />
          <RadioButton
            x:Name="CollectionTab"
            Style="{StaticResource TabOption}"
            GroupName="pedstab"
            Checked="OnPedsTab"
            Content="{loc:Tr ui.peds.characterCollection3}"
          />
        </StackPanel>
        <StackPanel x:Name="AddSection">
          <!-- Character pack: migrate the old gmm_peds into pedselector or attach a dropped-in Ped Selector pack -->
          <Border
            x:Name="PackUpdateCard"
            Background="{StaticResource Card}"
            BorderBrush="{StaticResource Accent}"
            BorderThickness="1"
            Padding="16,14"
            CornerRadius="12"
            Margin="0,0,0,14"
            Visibility="Collapsed"
          >
            <DockPanel>
              <Button
                x:Name="PackUpdateButton"
                DockPanel.Dock="Right"
                Style="{StaticResource Primary}"
                Click="OnSync"
                VerticalAlignment="Center"
                Margin="12,0,0,0"
              />
              <StackPanel>
                <TextBlock x:Name="PackUpdateTitle" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock
                  x:Name="PackUpdateText"
                  Foreground="{StaticResource Muted}"
                  Margin="0,3,0,0"
                  TextWrapping="Wrap"
                />
              </StackPanel>
            </DockPanel>
          </Border>

          <!-- In-game menu: a single clear button depending on the state -->
          <Border Background="{StaticResource Card}" Padding="16,14" CornerRadius="12" Margin="0,0,0,14">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button
                  x:Name="SelectorRemoveButton"
                  Content="{loc:Tr ui.peds.removeMenu}"
                  Style="{StaticResource Ghost}"
                  Click="OnRemoveSelector"
                  Margin="12,0,0,0"
                  Visibility="Collapsed"
                />
                <Button
                  x:Name="SelectorMainButton"
                  Content="{loc:Tr ui.peds.installMenu}"
                  Style="{StaticResource Primary}"
                  Click="OnInstallSelector"
                  Margin="8,0,0,0"
                  Visibility="Collapsed"
                />
              </StackPanel>
              <StackPanel>
                <TextBlock
                  x:Name="SelectorTitle"
                  Text="{loc:Tr ui.peds.gameMenu}"
                  FontSize="15"
                  FontWeight="SemiBold"
                  TextWrapping="Wrap"
                />
                <TextBlock
                  x:Name="SelectorText"
                  Foreground="{StaticResource Muted}"
                  Margin="0,3,0,0"
                  TextWrapping="Wrap"
                />
                <TextBlock
                  x:Name="Dependencies"
                  Foreground="{StaticResource Warn}"
                  Margin="0,4,0,0"
                  TextWrapping="Wrap"
                />
              </StackPanel>
            </DockPanel>
          </Border>

          <Expander x:Name="ScanWarnings" Foreground="{StaticResource Muted}" Margin="0,0,0,12" Visibility="Collapsed">
            <TextBox
              x:Name="ScanWarningsText"
              IsReadOnly="True"
              TextWrapping="Wrap"
              MaxHeight="140"
              VerticalScrollBarVisibility="Auto"
            />
          </Expander>

          <!-- Adding archives -->
          <Border
            Background="{StaticResource InsetFill}"
            BorderBrush="{StaticResource InsetEdge}"
            BorderThickness="1"
            CornerRadius="16"
            Padding="22"
            Margin="0,0,0,14"
          >
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Margin="20,0,0,0" VerticalAlignment="Center">
                <Button
                  Content="{loc:Tr ui.peds.addArchives}"
                  Style="{StaticResource Primary}"
                  Click="OnPick"
                />
                <Button
                  Content="{loc:Tr ui.peds.addFromSelector}"
                  Style="{StaticResource Ghost}"
                  ToolTip="{loc:Tr ui.peds.addFromSelectorTip}"
                  Click="OnImportSelector"
                  Margin="0,8,0,0"
                />
              </StackPanel>
              <StackPanel>
                <TextBlock
                  Text="{loc:Tr ui.peds.dropCharacterArchivesHere}"
                  FontFamily="Bahnschrift SemiBold, Bahnschrift, Segoe UI"
                  FontSize="19"
                />
                <TextBlock
                  Text="{loc:Tr ui.peds.zipRar7zMultipleFiles}"
                  Foreground="{StaticResource Muted}"
                  Margin="0,7,0,0"
                  TextWrapping="Wrap"
                />
              </StackPanel>
            </DockPanel>
          </Border>

          <!-- Detected characters: cards, everything is configured right here -->
          <StackPanel x:Name="QueuePanel" Visibility="Collapsed" Margin="0,0,0,18">
            <DockPanel Margin="0,0,0,4">
              <Button
                DockPanel.Dock="Right"
                Content="{loc:Tr ui.common.clear}"
                Style="{StaticResource Ghost}"
                Click="OnClearQueue"
              />
              <TextBlock
                x:Name="QueueTitle"
                Text="{loc:Tr ui.peds.charactersFound2}"
                FontSize="17"
                FontWeight="SemiBold"
                VerticalAlignment="Center"
              />
            </DockPanel>
            <TextBlock
              Text="{loc:Tr ui.peds.selectOnesWantSetTheir}"
              Foreground="{StaticResource Muted}"
              Margin="0,0,0,12"
            />
            <ItemsControl x:Name="CardList">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border
                    Width="214"
                    Margin="0,0,12,12"
                    Background="{StaticResource SmokedGlass}"
                    CornerRadius="14"
                    BorderThickness="2"
                    BorderBrush="{Binding Border}"
                  >
                    <StackPanel>
                      <Grid Height="236" Cursor="Hand" MouseLeftButtonUp="OnCardImageClick" Tag="{Binding}">
                        <Border CornerRadius="12,12,0,0" Background="#1B1D21">
                          <TextBlock
                            Text="{Binding Initials}"
                            FontFamily="Bahnschrift, Segoe UI"
                            FontSize="42"
                            FontWeight="Bold"
                            Foreground="#454952"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding PlaceholderVisibility}"
                          />
                        </Border>
                        <Border CornerRadius="10,10,0,0">
                          <Border.Background>
                            <ImageBrush ImageSource="{Binding Image}" Stretch="UniformToFill" AlignmentY="Top" />
                          </Border.Background>
                        </Border>
                        <CheckBox
                          IsChecked="{Binding Selected}"
                          IsEnabled="{Binding CanInstall}"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Top"
                          Margin="10"
                          ToolTip="{loc:Tr ui.peds.installCharacter}"
                        >
                          <CheckBox.LayoutTransform>
                            <ScaleTransform ScaleX="1.4" ScaleY="1.4" />
                          </CheckBox.LayoutTransform>
                        </CheckBox>
                        <!-- Browsing package images -->
                        <Button
                          Style="{StaticResource GalleryArrow}"
                          HorizontalAlignment="Left"
                          Margin="6,0,0,0"
                          Click="OnPrevImage"
                          Tag="{Binding}"
                          Visibility="{Binding ArrowsVisibility}"
                          ToolTip="{loc:Tr ui.peds.previousImage}"
                          Content="&#xE76B;"
                        />
                        <Button
                          Style="{StaticResource GalleryArrow}"
                          HorizontalAlignment="Right"
                          Margin="0,0,6,0"
                          Click="OnNextImage"
                          Tag="{Binding}"
                          Visibility="{Binding ArrowsVisibility}"
                          ToolTip="{loc:Tr ui.peds.nextImage}"
                          Content="&#xE76C;"
                        />
                        <Border
                          Background="#B0000000"
                          CornerRadius="6"
                          Padding="7,2"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Bottom"
                          Margin="8"
                          Visibility="{Binding ArrowsVisibility}"
                          IsHitTestVisible="False"
                        >
                          <TextBlock Text="{Binding Counter}" FontSize="11" Foreground="White" />
                        </Border>
                      </Grid>
                      <StackPanel Margin="12,10,12,12">
                        <TextBlock
                          Text="{Binding Title}"
                          FontFamily="Bahnschrift SemiBold, Bahnschrift, Segoe UI"
                          FontSize="15.5"
                          TextTrimming="CharacterEllipsis"
                          ToolTip="{Binding Title}"
                        />
                        <TextBlock
                          Text="{Binding Author}"
                          Foreground="{StaticResource Muted}"
                          FontSize="12"
                          TextTrimming="CharacterEllipsis"
                          Margin="0,2,0,0"
                          ToolTip="{Binding Author}"
                        />
                        <TextBlock
                          Text="{Binding SpawnText}"
                          Foreground="#6E6E6E"
                          FontSize="11"
                          TextTrimming="CharacterEllipsis"
                          Margin="0,2,0,8"
                        />
                        <StackPanel Orientation="Horizontal" Visibility="{Binding GenderChoiceVisibility}">
                          <RadioButton
                            Style="{StaticResource UnitChip}"
                            GroupName="{Binding Id}"
                            IsChecked="{Binding IsFemale}"
                            Content="{loc:Tr ui.common.female}"
                            Margin="0,0,6,0"
                          />
                          <RadioButton
                            Style="{StaticResource UnitChip}"
                            GroupName="{Binding Id}"
                            IsChecked="{Binding IsMale}"
                            Content="{loc:Tr ui.common.male}"
                          />
                        </StackPanel>
                        <TextBlock
                          Text="{Binding FixedGender}"
                          Visibility="{Binding FixedGenderVisibility}"
                          Foreground="{StaticResource Muted}"
                          FontSize="12"
                          ToolTip="{loc:Tr ui.peds.genderDefinedByModWill}"
                        />
                        <TextBlock
                          Text="{Binding Note}"
                          Visibility="{Binding NoteVisibility}"
                          Foreground="{StaticResource Warn}"
                          FontSize="11.5"
                          TextWrapping="Wrap"
                          Margin="0,6,0,0"
                        />
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <DockPanel Margin="0,4,0,0">
              <Button
                x:Name="InstallCardsButton"
                DockPanel.Dock="Left"
                Content="{loc:Tr ui.common.install}"
                Style="{StaticResource Primary}"
                Click="OnInstallQueue"
                MinWidth="200"
              />
              <TextBlock
                x:Name="CardsHint"
                Foreground="{StaticResource Muted}"
                VerticalAlignment="Center"
                Margin="14,0,0,0"
                TextWrapping="Wrap"
              />
            </DockPanel>
          </StackPanel>
        </StackPanel>

        <!-- Collection: installed characters -->
        <StackPanel x:Name="CollectionSection" Visibility="Collapsed">
          <DockPanel Margin="0,0,0,10">
            <Button
              x:Name="DeleteSelected"
              DockPanel.Dock="Right"
              Content="{loc:Tr ui.peds.removeSelected}"
              Style="{StaticResource Ghost}"
              Click="OnRemoveSelected"
              IsEnabled="False"
            />
            <TextBlock
              x:Name="InstalledTitle"
              Text="{loc:Tr ui.peds.installedCharacters}"
              FontSize="18"
              FontWeight="SemiBold"
              VerticalAlignment="Center"
            />
          </DockPanel>
          <CheckBox
            x:Name="SelectAll"
            Content="{loc:Tr ui.peds.selectAllCustomModels}"
            Foreground="{StaticResource Muted}"
            Checked="OnSelectAll"
            Unchecked="OnSelectAll"
            Margin="0,0,0,10"
          />
          <TextBlock
            x:Name="EmptyInstalled"
            Text="{loc:Tr ui.peds.noCharactersInstalledYetAdd}"
            Foreground="{StaticResource Muted}"
            Margin="0,0,0,12"
          />
          <ItemsControl x:Name="Installed">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border
                  Background="{StaticResource SmokedGlass}"
                  BorderBrush="{StaticResource SmokedEdge}"
                  BorderThickness="1"
                  CornerRadius="14"
                  Padding="14"
                  Margin="0,0,0,10"
                >
                  <StackPanel>
                    <Button
                      Style="{StaticResource Ghost}"
                      Click="OnOpenPackage"
                      Tag="{Binding}"
                      HorizontalContentAlignment="Left"
                      Padding="14,9"
                      HorizontalAlignment="Left"
                      ToolTip="{loc:Tr ui.peds.readmeAuthorsInstructionsPreviews}"
                    >
                      <StackPanel>
                        <TextBlock
                          Text="{Binding Title}"
                          FontFamily="Bahnschrift SemiBold, Bahnschrift, Segoe UI"
                          FontSize="16"
                          TextTrimming="CharacterEllipsis"
                        />
                        <TextBlock
                          Text="{Binding Summary}"
                          Foreground="{StaticResource Muted}"
                          FontSize="11"
                          Margin="0,3,0,0"
                        />
                      </StackPanel>
                    </Button>
                    <ItemsControl ItemsSource="{Binding Models}" Margin="0,8,0,0">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <DockPanel Margin="0,3,0,3">
                            <Button
                              DockPanel.Dock="Right"
                              Content="{loc:Tr ui.common.remove}"
                              Style="{StaticResource Ghost}"
                              Click="OnRemovePed"
                              Tag="{Binding}"
                              IsEnabled="{Binding Entry.Managed}"
                              Padding="12,5"
                            />
                            <CheckBox
                              DockPanel.Dock="Left"
                              IsChecked="{Binding Selected}"
                              IsEnabled="{Binding Entry.Managed}"
                              Margin="0,0,10,0"
                              VerticalAlignment="Center"
                            />
                            <TextBlock
                              Text="{Binding Label}"
                              VerticalAlignment="Center"
                              TextTrimming="CharacterEllipsis"
                              Margin="0,0,12,0"
                            />
                          </DockPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </StackPanel>
      <Expander
        x:Name="OperationDetails"
        Header="{loc:Tr ui.peds.lastActionDetails}"
        Foreground="{StaticResource Muted}"
        Visibility="Collapsed"
        Margin="0,10,0,0"
      >
        <TextBox
          x:Name="OperationLog"
          IsReadOnly="True"
          TextWrapping="Wrap"
          MaxHeight="180"
          VerticalScrollBarVisibility="Auto"
        />
      </Expander>
    </StackPanel>
  </ScrollViewer>
</UserControl>
