<UserControl
  x:Class="GTAModManager.App.Base.ReadinessGate"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Background="{StaticResource Bg}"
  AllowDrop="True"
  xmlns:loc="clr-namespace:GTAModManager.App.Localization"
>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Border
      Background="{StaticResource SmokedGlass}"
      BorderBrush="{StaticResource SmokedEdge}"
      BorderThickness="1"
      CornerRadius="18"
      Padding="34,28"
      Margin="28,24"
      MaxWidth="780"
      VerticalAlignment="Center"
      HorizontalAlignment="Center"
    >
      <StackPanel>
        <TextBlock
          x:Name="Kicker"
          Text="{loc:Tr ui.base.gtaVSetup}"
          Foreground="{StaticResource AccentLight}"
          FontSize="11.5"
          FontWeight="Bold"
        />
        <TextBlock
          Style="{StaticResource PageTitle}"
          Text="{loc:Tr ui.base.firstLetSPrepareGame}"
          FontSize="28"
          Margin="0,4,0,0"
        />
        <TextBlock
          Foreground="{StaticResource Muted}"
          TextWrapping="Wrap"
          Margin="0,6,0,20"
          FontSize="13.5"
          Text="{loc:Tr ui.base.modsCannotRunWithoutBase}"
        />

        <!-- Steps -->
        <Border
          Background="{StaticResource InsetFill}"
          BorderBrush="{StaticResource InsetEdge}"
          BorderThickness="1"
          CornerRadius="12"
          Padding="18,6"
        >
          <StackPanel>
            <DockPanel Margin="0,10">
              <Border x:Name="Mark1" Width="34" Height="34" CornerRadius="17" VerticalAlignment="Top" Margin="0,0,14,0">
                <TextBlock
                  x:Name="Mark1Text"
                  Text="1"
                  FontFamily="Bahnschrift"
                  FontWeight="Bold"
                  FontSize="15"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                />
              </Border>
              <StackPanel>
                <TextBlock Text="{loc:Tr ui.base.firstGameLaunch}" FontSize="15.5" FontWeight="SemiBold" />
                <TextBlock x:Name="Detail1" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0" />
              </StackPanel>
            </DockPanel>
            <Rectangle Height="1" Fill="{StaticResource Line}" Opacity="0.6" />
            <DockPanel Margin="0,10">
              <Border x:Name="Mark2" Width="34" Height="34" CornerRadius="17" VerticalAlignment="Top" Margin="0,0,14,0">
                <TextBlock
                  x:Name="Mark2Text"
                  Text="2"
                  FontFamily="Bahnschrift"
                  FontWeight="Bold"
                  FontSize="15"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                />
              </Border>
              <StackPanel>
                <TextBlock Text="{loc:Tr ui.base.battleyeDisabled}" FontSize="15.5" FontWeight="SemiBold" />
                <TextBlock x:Name="Detail2" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0" />
              </StackPanel>
            </DockPanel>
            <Rectangle Height="1" Fill="{StaticResource Line}" Opacity="0.6" />
            <DockPanel Margin="0,10">
              <Border x:Name="Mark3" Width="34" Height="34" CornerRadius="17" VerticalAlignment="Top" Margin="0,0,14,0">
                <TextBlock
                  x:Name="Mark3Text"
                  Text="3"
                  FontFamily="Bahnschrift"
                  FontWeight="Bold"
                  FontSize="15"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                />
              </Border>
              <StackPanel>
                <TextBlock Text="{loc:Tr ui.common.basePackage}" FontSize="15.5" FontWeight="SemiBold" />
                <TextBlock x:Name="Detail3" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0" />
              </StackPanel>
            </DockPanel>
          </StackPanel>
        </Border>

        <!-- What to do now -->
        <TextBlock x:Name="NowTitle" FontFamily="Bahnschrift" FontWeight="SemiBold" FontSize="19" Margin="0,22,0,6" />
        <TextBlock x:Name="NowText" TextWrapping="Wrap" FontSize="13.5" LineHeight="21" />

        <!-- ScriptHookVDotNet build for Legacy: both work there, the user picks one -->
        <WrapPanel x:Name="ShvdnChoice" Orientation="Horizontal" Margin="0,14,0,0" Visibility="Collapsed">
          <TextBlock
            Text="{loc:Tr ui.base.whichScripthookvdotnetInstall}"
            Foreground="{StaticResource Muted}"
            VerticalAlignment="Center"
            Margin="0,0,10,0"
          />
          <RadioButton
            x:Name="ShvdnNightly"
            Style="{StaticResource UnitChip}"
            GroupName="gate-shvdn"
            IsChecked="True"
            Content="{loc:Tr ui.base.nightly}"
            Margin="0,0,6,0"
            ToolTip="{loc:Tr ui.base.officialScripthookvdotnetNightlyBuildLatest}"
          />
          <RadioButton
            x:Name="ShvdnEnhanced"
            Style="{StaticResource UnitChip}"
            GroupName="gate-shvdn"
            Content="{loc:Tr ui.base.legacyEnhancedChihebBacha}"
            ToolTip="{loc:Tr ui.base.scripthookvdotnetEnhancedBuildOneVersion}"
          />
        </WrapPanel>

        <WrapPanel Margin="0,20,0,0">
          <Button
            x:Name="ActionButton"
            Style="{StaticResource Primary}"
            Padding="22,11"
            FontSize="14"
            Click="OnAction"
            Margin="0,0,10,8"
          />
          <Button
            x:Name="CheckButton"
            Style="{StaticResource Ghost}"
            Content="{loc:Tr ui.base.checkAgain}"
            Click="OnCheck"
            Margin="0,0,10,8"
          />
          <Button
            x:Name="SkipButton"
            Style="{StaticResource Ghost}"
            Click="OnSkip"
            Margin="0,0,0,8"
            Visibility="Collapsed"
          />
        </WrapPanel>
        <ProgressBar
          x:Name="Progress"
          IsIndeterminate="True"
          Height="4"
          Margin="0,10,0,0"
          Foreground="{StaticResource Accent}"
          Background="#2B2E34"
          BorderThickness="0"
          Visibility="Collapsed"
        />
        <TextBlock
          x:Name="StatusText"
          Foreground="{StaticResource Muted}"
          FontSize="12.5"
          TextWrapping="Wrap"
          Margin="0,8,0,0"
        />
      </StackPanel>
    </Border>
  </ScrollViewer>
</UserControl>
