<Window
  x:Class="GTAModManager.App.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:kb="clr-namespace:GTAModManager.App.Keybinds"
  xmlns:dv="clr-namespace:GTAModManager.App.Discover"
  xmlns:bs="clr-namespace:GTAModManager.App.Base"
  xmlns:ped="clr-namespace:GTAModManager.App.Peds"
  xmlns:inst="clr-namespace:GTAModManager.App.Installation"
  xmlns:inv="clr-namespace:GTAModManager.App.Inventory"
  Title="{loc:Tr ui.main.modHubByVirtuozz}"
  Icon="app.ico"
  Width="1220"
  Height="800"
  MinWidth="1000"
  MinHeight="640"
  Background="{StaticResource Bg}"
  WindowStartupLocation="CenterScreen"
  UseLayoutRounding="True"
  TextOptions.TextFormattingMode="Display"
  TextOptions.TextRenderingMode="ClearType"
  AllowDrop="True"
  Drop="OnDrop"
  DragOver="OnDragOver"
  StateChanged="OnWindowStateChanged"
  xmlns:loc="clr-namespace:GTAModManager.App.Localization"
>
  <Window.Resources>
    <Style x:Key="EditionIcon" TargetType="Button">
      <Setter Property="Width" Value="30" /><Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="0" /><Setter Property="Cursor" Value="Hand" />
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" /><Setter
        Property="FontSize"
        Value="14"
      />
      <Setter Property="Foreground" Value="#FFFFFF" /><Setter Property="Background" Value="#42454B" />
      <Setter Property="AutomationProperties.Name" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border
              x:Name="IconBorder"
              Background="{TemplateBinding Background}"
              CornerRadius="7"
              BorderBrush="#668F969E"
              BorderThickness="1"
            >
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="IconBorder" Property="Opacity" Value="0.8" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="IconBorder" Property="Opacity" Value="0.6" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="IconBorder" Property="BorderBrush" Value="#FFFFFF" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="IconBorder" Property="Opacity" Value="0.3" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="EditionPlayIcon" TargetType="Button" BasedOn="{StaticResource EditionIcon}">
      <Setter Property="Background" Value="#159447" />
      <Setter Property="ContentTemplate">
        <Setter.Value>
          <DataTemplate>
            <Viewbox Width="13" Height="14">
              <Path Fill="White" Data="M 2,1 L 14,9 L 2,17 Z" />
            </Viewbox>
          </DataTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="EditionFolderIcon" TargetType="Button" BasedOn="{StaticResource EditionIcon}">
      <Setter Property="ContentTemplate">
        <Setter.Value>
          <DataTemplate>
            <Viewbox Width="16" Height="14">
              <Path
                Stroke="#F2F4F7"
                StrokeThickness="1.7"
                StrokeLineJoin="Round"
                Data="M 2,5 L 8,5 L 10,8 L 22,8 L 22,20 L 2,20 Z M 2,9 L 22,9"
              />
            </Viewbox>
          </DataTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <WindowChrome.WindowChrome>
    <WindowChrome
      CaptionHeight="42"
      ResizeBorderThickness="6"
      GlassFrameThickness="0"
      CornerRadius="0"
      UseAeroCaptionButtons="False"
    />
  </WindowChrome.WindowChrome>

  <Border x:Name="RootBorder" BorderBrush="{StaticResource Line}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="42" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- Window caption -->
      <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button
              Style="{StaticResource CaptionButton}"
              Content="&#xE921;"
              Click="OnMinimize"
              ToolTip="{loc:Tr ui.main.minimize}"
            />
            <Button
              x:Name="MaxButton"
              Style="{StaticResource CaptionButton}"
              Content="&#xE922;"
              Click="OnMaximize"
              ToolTip="{loc:Tr ui.main.expand}"
            />
            <Button
              Style="{StaticResource CloseButton}"
              Content="&#xE8BB;"
              Click="OnClose"
              ToolTip="{loc:Tr ui.common.close}"
            />
          </StackPanel>
          <!-- Bell: updates are available for mods from Recommendations (red dot); click shows the list -->
          <Button
            x:Name="UpdatesBell"
            DockPanel.Dock="Right"
            Click="OnUpdatesBell"
            Cursor="Hand"
            Margin="0,0,10,0"
            VerticalAlignment="Center"
            Tag="Collapsed"
            WindowChrome.IsHitTestVisibleInChrome="True"
            ToolTip="{loc:Tr ui.common.modUpdates}"
          >
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Grid x:Name="bell" Background="Transparent" Width="32" Height="30">
                  <TextBlock
                    Text="&#xEA8F;"
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="16"
                    Foreground="{StaticResource Muted}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                  />
                  <Ellipse
                    x:Name="UpdatesDot"
                    Width="8"
                    Height="8"
                    Fill="#E5484D"
                    Stroke="{StaticResource Panel}"
                    StrokeThickness="1.5"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,5,6,0"
                    Visibility="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                  />
                </Grid>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="bell" Property="Opacity" Value="0.8" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Button.Template>
          </Button>
          <!-- "Made exclusively for GTA5-Mods": click opens the site in the system browser -->
          <Button
            DockPanel.Dock="Right"
            Click="OnOpenGta5Mods"
            Cursor="Hand"
            Margin="0,0,14,0"
            VerticalAlignment="Center"
            WindowChrome.IsHitTestVisibleInChrome="True"
            ToolTip="{loc:Tr ui.main.gta5ModsCom}"
          >
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <StackPanel Orientation="Horizontal" Background="Transparent">
                  <TextBlock
                    Text="{loc:Tr ui.main.developedExclusively}"
                    Foreground="{StaticResource Muted}"
                    FontSize="12"
                    VerticalAlignment="Center"
                    Margin="0,0,8,0"
                  />
                  <ContentControl
                    x:Name="plate"
                    Style="{StaticResource FiveModsPlate}"
                    FontSize="16"
                    VerticalAlignment="Center"
                  />
                </StackPanel>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="plate" Property="Opacity" Value="0.85" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Button.Template>
          </Button>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
            <!-- "Mod hub by VirtuOzZ": click opens the author's GTA5-Mods profile -->
            <Button
              Click="OnOpenAuthorProfile"
              Cursor="Hand"
              VerticalAlignment="Center"
              WindowChrome.IsHitTestVisibleInChrome="True"
              ToolTip="{loc:Tr ui.main.virtuozzSGta5ModsProfile}"
            >
              <Button.Template>
                <ControlTemplate TargetType="Button">
                  <StackPanel x:Name="brand" Orientation="Horizontal" Background="Transparent">
                    <ContentPresenter />
                  </StackPanel>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="brand" Property="Opacity" Value="0.82" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Button.Template>
              <StackPanel Orientation="Horizontal">
                <!-- ModHub logo: "Mod" in white + "hub" on an orange plate -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock
                    Text="{loc:Tr ui.main.mod}"
                    FontFamily="Arial"
                    FontWeight="Bold"
                    FontSize="18"
                    Foreground="White"
                    VerticalAlignment="Center"
                    Margin="0,0,3,0"
                  />
                  <Border
                    Background="{StaticResource Accent}"
                    CornerRadius="4"
                    Padding="5,0,5,1"
                    VerticalAlignment="Center"
                  >
                    <TextBlock
                      Text="{loc:Tr ui.main.hub}"
                      FontFamily="Arial"
                      FontWeight="Bold"
                      FontSize="18"
                      Foreground="#0C0C0C"
                    />
                  </Border>
                </StackPanel>
                <TextBlock
                  Text="{loc:Tr ui.main.byVirtuozz}"
                  FontFamily="Bahnschrift SemiBold, Bahnschrift, Segoe UI"
                  Foreground="{StaticResource AccentLight}"
                  FontSize="14"
                  VerticalAlignment="Center"
                  Margin="8,1,0,0"
                />
              </StackPanel>
            </Button>
            <TextBlock
              Text="{loc:Tr ui.main.gtaVModManager}"
              Foreground="{StaticResource Muted}"
              FontSize="12.5"
              VerticalAlignment="Center"
            />
          </StackPanel>
        </DockPanel>
      </Border>

      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="290" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <DockPanel Margin="16,20,16,16">
              <StackPanel DockPanel.Dock="Top">
                <TextBlock
                  Text="{loc:Tr ui.main.game}"
                  Foreground="{StaticResource Muted}"
                  FontSize="11"
                  FontWeight="SemiBold"
                  Margin="2,0,0,8"
                />
                <Grid>
                  <RadioButton
                    x:Name="LegacyOption"
                    Style="{StaticResource SideOption}"
                    GroupName="edition"
                    Checked="OnEditionChanged"
                  >
                    <StackPanel Margin="0,0,76,0">
                      <TextBlock Text="{loc:Tr ui.main.gtaVLegacy}" FontSize="15" FontWeight="SemiBold" />
                      <TextBlock
                        x:Name="LegacyPath"
                        Text="{loc:Tr ui.main.notFound2}"
                        Foreground="{StaticResource Muted}"
                        FontSize="11.5"
                        TextTrimming="CharacterEllipsis"
                        Margin="0,3,0,0"
                      />
                    </StackPanel>
                  </RadioButton>
                  <StackPanel
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,9,8"
                  >
                    <Button
                      x:Name="LegacyPlayShortcut"
                      Tag="Legacy"
                      Style="{StaticResource EditionPlayIcon}"
                      Click="OnEditionPlay"
                      IsEnabled="False"
                    />
                    <Button
                      x:Name="LegacyFolderShortcut"
                      Tag="Legacy"
                      Style="{StaticResource EditionFolderIcon}"
                      Click="OnEditionFolder"
                      IsEnabled="False"
                      Margin="5,0,0,0"
                    />
                  </StackPanel>
                </Grid>
                <Grid>
                  <RadioButton
                    x:Name="EnhancedOption"
                    Style="{StaticResource SideOption}"
                    GroupName="edition"
                    Checked="OnEditionChanged"
                  >
                    <StackPanel Margin="0,0,76,0">
                      <TextBlock Text="{loc:Tr ui.main.gtaVEnhanced2}" FontSize="15" FontWeight="SemiBold" />
                      <TextBlock
                        x:Name="EnhancedPath"
                        Text="{loc:Tr ui.main.notFound2}"
                        Foreground="{StaticResource Muted}"
                        FontSize="11.5"
                        TextTrimming="CharacterEllipsis"
                        Margin="0,3,0,0"
                      />
                    </StackPanel>
                  </RadioButton>
                  <StackPanel
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,9,8"
                  >
                    <Button
                      x:Name="EnhancedPlayShortcut"
                      Tag="Enhanced"
                      Style="{StaticResource EditionPlayIcon}"
                      Click="OnEditionPlay"
                      IsEnabled="False"
                    />
                    <Button
                      x:Name="EnhancedFolderShortcut"
                      Tag="Enhanced"
                      Style="{StaticResource EditionFolderIcon}"
                      Click="OnEditionFolder"
                      IsEnabled="False"
                      Margin="5,0,0,0"
                    />
                  </StackPanel>
                </Grid>
                <Button
                  Content="{loc:Tr ui.main.specifyGameFolderManually}"
                  Style="{StaticResource Ghost}"
                  Click="OnBrowseGame"
                  Margin="0,2,0,24"
                />

                <TextBlock
                  Text="{loc:Tr ui.main.section}"
                  Foreground="{StaticResource Muted}"
                  FontSize="11"
                  FontWeight="SemiBold"
                  Margin="2,0,0,8"
                />
                <RadioButton
                  x:Name="InstallTab"
                  Style="{StaticResource SideOption}"
                  GroupName="page"
                  IsChecked="True"
                  Checked="OnPageChanged"
                >
                  <TextBlock Text="{loc:Tr ui.common.modInstallation}" FontSize="14" />
                </RadioButton>
                <RadioButton
                  x:Name="MyModsTab"
                  Style="{StaticResource SideOption}"
                  GroupName="page"
                  Checked="OnPageChanged"
                >
                  <StackPanel>
                    <TextBlock Text="{loc:Tr ui.common.myMods}" FontSize="14" />
                    <TextBlock
                      x:Name="MyModsTabInfo"
                      Foreground="{StaticResource Muted}"
                      FontSize="11.5"
                      Margin="0,3,0,0"
                      Visibility="Collapsed"
                    />
                  </StackPanel>
                </RadioButton>
                <RadioButton
                  x:Name="HistoryTab"
                  Style="{StaticResource SideOption}"
                  GroupName="page"
                  Checked="OnPageChanged"
                >
                  <TextBlock Text="{loc:Tr ui.main.historyUndo}" FontSize="14" />
                </RadioButton>
                <RadioButton
                  x:Name="KeybindsTab"
                  Style="{StaticResource SideOption}"
                  GroupName="page"
                  Checked="OnPageChanged"
                >
                  <TextBlock Text="{loc:Tr ui.common.hotkeys}" FontSize="14" />
                </RadioButton>
                <RadioButton
                  x:Name="DiscoverTab"
                  Style="{StaticResource SideOption}"
                  GroupName="page"
                  Checked="OnPageChanged"
                >
                  <TextBlock Text="{loc:Tr ui.common.recommendations}" FontSize="14" />
                </RadioButton>
                <RadioButton
                  x:Name="PedsTab"
                  Style="{StaticResource SideOption}"
                  GroupName="page"
                  Checked="OnPageChanged"
                >
                  <TextBlock Text="{loc:Tr ui.common.addCharacters}" FontSize="14" />
                </RadioButton>
                <RadioButton
                  x:Name="AccessoriesTab"
                  Style="{StaticResource SideOption}"
                  GroupName="page"
                  Checked="OnAccessoriesTab"
                  Unchecked="OnAccessoriesTabOff"
                >
                  <TextBlock Text="{loc:Tr ui.common.characterAccessories}" FontSize="14" />
                </RadioButton>
                <RadioButton
                  x:Name="BackupTab"
                  Style="{StaticResource SideOption}"
                  GroupName="page"
                  Checked="OnPageChanged"
                >
                  <StackPanel>
                    <TextBlock Text="{loc:Tr ui.main.settings}" FontSize="14" />
                    <TextBlock
                      x:Name="BackupTabInfo"
                      Foreground="{StaticResource Muted}"
                      FontSize="11.5"
                      Margin="0,3,0,0"
                    />
                  </StackPanel>
                </RadioButton>
              </StackPanel>

              <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
                <Border Background="{StaticResource Card}" CornerRadius="10" Padding="12" Margin="0,12,0,10">
                  <StackPanel>
                    <TextBlock
                      Text="{loc:Tr ui.main.selectedGame}"
                      Foreground="{StaticResource Muted}"
                      FontSize="10.5"
                      Margin="0,0,0,5"
                    />
                    <TextBlock
                      x:Name="ModModeText"
                      Text="{loc:Tr ui.main.selectGtaVVersion}"
                      TextWrapping="Wrap"
                      FontSize="12"
                      Margin="0,0,0,8"
                    />
                    <Button
                      x:Name="PlayButton"
                      Content="{loc:Tr ui.main.play}"
                      Style="{StaticResource Primary}"
                      Click="OnPlayGame"
                      IsEnabled="False"
                      Margin="0,0,0,6"
                    />
                    <Button
                      x:Name="ModModeButton"
                      Content="{loc:Tr ui.common.disableMods}"
                      Style="{StaticResource Ghost}"
                      Click="OnToggleMods"
                      IsEnabled="False"
                    />
                    <Button
                      x:Name="VanillaButton"
                      Content="{loc:Tr ui.common.restoreVanillaGame}"
                      Style="{StaticResource Ghost}"
                      Click="OnVanillaRestore"
                      IsEnabled="False"
                      Margin="0,6,0,0"
                      ToolTip="{loc:Tr ui.main.removesAllModsAllTraces}"
                    />
                  </StackPanel>
                </Border>
                <Border
                  x:Name="LoaderBanner"
                  Background="#3A311C"
                  CornerRadius="8"
                  Padding="12,10"
                  Margin="0,0,0,8"
                  Visibility="Collapsed"
                >
                  <TextBlock
                    x:Name="LoaderBannerText"
                    Foreground="{StaticResource Warn}"
                    TextWrapping="Wrap"
                    FontSize="12"
                  />
                </Border>
                <Border
                  x:Name="AdjusterBanner"
                  Background="#3A311C"
                  CornerRadius="8"
                  Padding="12,10"
                  Margin="0,0,0,8"
                  Visibility="Collapsed"
                >
                  <TextBlock
                    x:Name="AdjusterBannerText"
                    Foreground="{StaticResource Warn}"
                    TextWrapping="Wrap"
                    FontSize="12"
                  />
                </Border>
                <Border
                  x:Name="PermissionBanner"
                  Background="#3A311C"
                  CornerRadius="8"
                  Padding="12,10"
                  Margin="0,0,0,8"
                  Visibility="Collapsed"
                >
                  <StackPanel>
                    <TextBlock
                      Text="{loc:Tr ui.main.gameFolderNotWritableMods}"
                      Foreground="{StaticResource Warn}"
                      TextWrapping="Wrap"
                      FontSize="12"
                    />
                    <Button
                      x:Name="PermissionFixButton"
                      Content="{loc:Tr ui.main.fix}"
                      Style="{StaticResource Primary}"
                      Padding="14,6"
                      Margin="0,8,0,0"
                      HorizontalAlignment="Left"
                      Click="OnFixPermissions"
                    />
                  </StackPanel>
                </Border>
                <Border
                  x:Name="RunningBanner"
                  Background="#3A1F1F"
                  CornerRadius="8"
                  Padding="12,10"
                  Visibility="Collapsed"
                >
                  <TextBlock
                    Text="{loc:Tr ui.main.gameRunningChangesLocked}"
                    Foreground="{StaticResource Bad}"
                    TextWrapping="Wrap"
                  />
                </Border>
                <TextBlock
                  x:Name="GameInfo"
                  Foreground="{StaticResource Muted}"
                  FontSize="11.5"
                  TextWrapping="Wrap"
                  Margin="2,10,0,0"
                />
              </StackPanel>
            </DockPanel>
          </ScrollViewer>
        </Border>

        <!-- Installation -->
        <Grid x:Name="InstallPage" Grid.Column="1" Margin="24,20,24,16">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <DockPanel Margin="0,0,0,16">
            <Button
              DockPanel.Dock="Right"
              Content="{loc:Tr ui.main.selectMod}"
              Style="{StaticResource Primary}"
              Click="OnPickPackage"
              VerticalAlignment="Top"
            />
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{loc:Tr ui.common.modInstallation}" Style="{StaticResource PageTitle}" />
              <TextBlock
                Text="{loc:Tr ui.main.oivPackageModArchiveZip}"
                Foreground="{StaticResource Muted}"
                Margin="0,3,0,0"
                TextWrapping="Wrap"
              />
              <!-- Tools: game files in mods (installation page windows) -->
              <WrapPanel Margin="0,10,0,0">
                <Button
                  Content="{loc:Tr ui.main.gameconfig}"
                  Style="{StaticResource Ghost}"
                  Padding="12,5"
                  Margin="0,0,6,0"
                  Click="OnOpenGameConfig"
                  ToolTip="{loc:Tr ui.main.openGameconfigXmlFromMods}"
                />
                <Button
                  Content="{loc:Tr ui.main.dlcList}"
                  Style="{StaticResource Ghost}"
                  Padding="12,5"
                  Margin="0,0,6,0"
                  Click="OnOpenDlcList"
                  ToolTip="{loc:Tr ui.main.openDlclistXmlFromMods}"
                />
                <Button
                  Content="{loc:Tr ui.common.openRpf}"
                  Style="{StaticResource Ghost}"
                  Padding="12,5"
                  Click="OnOpenRpf"
                  ToolTip="{loc:Tr ui.main.rpfBrowserOriginalsReadOnly}"
                />
              </WrapPanel>
            </StackPanel>
          </DockPanel>

          <!-- Modding essentials (visible while something is missing) -->
          <ContentControl x:Name="BaseCardHost" Grid.Row="1" />

          <!-- Package card -->
          <Border
            x:Name="PackageCard"
            Grid.Row="2"
            Background="{StaticResource Card}"
            CornerRadius="14"
            Visibility="Collapsed"
            Margin="0,0,0,14"
          >
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>

              <!-- Header in the package colours -->
              <Border x:Name="PackageHeader" CornerRadius="14,14,0,0" Padding="24,22">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Border
                    x:Name="PackageIconBox"
                    Width="104"
                    Height="104"
                    CornerRadius="16"
                    ClipToBounds="True"
                    Margin="0,0,22,0"
                  >
                    <Border.Effect>
                      <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.45" />
                    </Border.Effect>
                    <Grid>
                      <TextBlock
                        x:Name="PackageIconFallback"
                        Text="{loc:Tr ui.main.oiv}"
                        FontSize="26"
                        FontWeight="Bold"
                        Opacity="0.5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                      />
                      <Image x:Name="PackageIcon" Stretch="UniformToFill">
                        <Image.Clip>
                          <RectangleGeometry Rect="0,0,104,104" RadiusX="16" RadiusY="16" />
                        </Image.Clip>
                      </Image>
                    </Grid>
                  </Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock
                      x:Name="PackageName"
                      FontFamily="Bahnschrift SemiBold, Bahnschrift, Segoe UI"
                      FontSize="26"
                      TextWrapping="Wrap"
                    />
                    <TextBlock x:Name="PackageMeta" Opacity="0.75" Margin="0,6,0,0" FontSize="13" />
                    <WrapPanel Margin="0,12,0,0">
                      <Border
                        x:Name="EditionChip"
                        CornerRadius="6"
                        Padding="10,4"
                        Margin="0,0,8,0"
                        Background="#33000000"
                      >
                        <TextBlock x:Name="EditionChipText" FontSize="12" FontWeight="SemiBold" />
                      </Border>
                      <Button
                        x:Name="AuthorLinkButton"
                        Style="{StaticResource LinkButton}"
                        Click="OnOpenLink"
                        Margin="0,0,8,0"
                      >
                        <TextBlock x:Name="AuthorLinkText" FontSize="12" />
                      </Button>
                      <Button x:Name="FooterLinkButton" Style="{StaticResource LinkButton}" Click="OnOpenLink">
                        <TextBlock x:Name="FooterLinkText" FontSize="12" />
                      </Button>
                    </WrapPanel>
                  </StackPanel>
                  <!-- Close package: back to the empty drop zone -->
                  <Button
                    Grid.Column="1"
                    Content="✕"
                    Style="{StaticResource Ghost}"
                    Padding="10,4"
                    FontSize="14"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,-10,-12,0"
                    Click="OnClosePackage"
                    ToolTip="{loc:Tr ui.main.closePackage}"
                  />
                </Grid>
              </Border>

              <!-- Tabs -->
              <Border Grid.Row="1" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="24,0">
                <StackPanel Orientation="Horizontal">
                  <RadioButton
                    x:Name="DescTab"
                    Style="{StaticResource TabOption}"
                    GroupName="pkgtab"
                    IsChecked="True"
                    Checked="OnPackageTabChanged"
                    Content="{loc:Tr ui.main.description}"
                  />
                  <RadioButton
                    x:Name="ControlsTab"
                    Style="{StaticResource TabOption}"
                    GroupName="pkgtab"
                    Checked="OnPackageTabChanged"
                    Content="{loc:Tr ui.main.controls2}"
                    Visibility="Collapsed"
                  />
                  <RadioButton
                    x:Name="ChangesTab"
                    Style="{StaticResource TabOption}"
                    GroupName="pkgtab"
                    Checked="OnPackageTabChanged"
                    Content="{loc:Tr ui.main.changes2}"
                  />
                  <RadioButton
                    x:Name="LicenceTab"
                    Style="{StaticResource TabOption}"
                    GroupName="pkgtab"
                    Checked="OnPackageTabChanged"
                    Content="{loc:Tr ui.main.license}"
                  />
                </StackPanel>
              </Border>

              <!-- Description -->
              <ScrollViewer x:Name="DescView" Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="24,18,16,18">
                <StackPanel MaxWidth="980" HorizontalAlignment="Left">
                  <Border
                    x:Name="EditionWarning"
                    Background="#3A311C"
                    CornerRadius="8"
                    Padding="12,8"
                    Margin="0,0,0,14"
                    Visibility="Collapsed"
                  >
                    <TextBlock x:Name="EditionWarningText" Foreground="{StaticResource Warn}" TextWrapping="Wrap" />
                  </Border>
                  <!-- Author requirements from the README that are missing in the game -->
                  <Border
                    x:Name="RequirementsWarning"
                    Background="#3A1F1F"
                    CornerRadius="8"
                    Padding="12,10"
                    Margin="0,0,0,14"
                    Visibility="Collapsed"
                  >
                    <TextBlock x:Name="RequirementsText" Foreground="#FFB3B3" TextWrapping="Wrap" />
                  </Border>
                  <!-- Optional components next to the OIV: installed after it -->
                  <Border
                    x:Name="ExtrasCard"
                    Background="{StaticResource SmokedGlass}"
                    BorderBrush="{StaticResource SmokedEdge}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,10"
                    Margin="0,0,0,14"
                    Visibility="Collapsed"
                  >
                    <StackPanel>
                      <TextBlock Text="{loc:Tr ui.common.additionalComponents}" FontWeight="SemiBold" />
                      <TextBlock
                        Text="{loc:Tr ui.main.foundAlongsideOivArchiveSelected}"
                        Foreground="{StaticResource Muted}"
                        FontSize="12"
                        TextWrapping="Wrap"
                        Margin="0,2,0,6"
                      />
                      <StackPanel x:Name="ExtrasList" />
                    </StackPanel>
                  </Border>
                  <!-- Bilingual descriptions (English + Russian in one text): pick the version to read. -->
                  <StackPanel
                    x:Name="DescLanguages"
                    Orientation="Horizontal"
                    Margin="-6,0,0,12"
                    Visibility="Collapsed"
                  />
                  <TextBlock
                    x:Name="PackageDescription"
                    Foreground="#E0E0E0"
                    TextWrapping="Wrap"
                    FontSize="13.5"
                    LineHeight="21"
                  />
                </StackPanel>
              </ScrollViewer>

              <!-- Controls: groups, keys as key caps, action -->
              <ScrollViewer
                x:Name="ControlsView"
                Grid.Row="2"
                VerticalScrollBarVisibility="Auto"
                Padding="24,18,16,18"
                Visibility="Collapsed"
              >
                <ItemsControl x:Name="ControlsList" MaxWidth="980" HorizontalAlignment="Left">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border
                        Background="{StaticResource InsetFill}"
                        BorderBrush="{StaticResource InsetEdge}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="18,14"
                        Margin="0,0,0,12"
                      >
                        <StackPanel>
                          <TextBlock
                            Text="{Binding Title}"
                            Visibility="{Binding TitleVisibility}"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource Accent}"
                            Margin="0,0,0,10"
                          />
                          <ItemsControl ItemsSource="{Binding Rows}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <Grid Margin="0,3">
                                  <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="300" />
                                    <ColumnDefinition Width="*" />
                                  </Grid.ColumnDefinitions>
                                  <ItemsControl ItemsSource="{Binding Keys}" VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                      <ItemsPanelTemplate>
                                        <WrapPanel />
                                      </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                      <DataTemplate>
                                        <Border
                                          Background="{Binding Background}"
                                          BorderBrush="{Binding Border}"
                                          BorderThickness="{Binding BorderThickness}"
                                          CornerRadius="5"
                                          Padding="{Binding Padding}"
                                          Margin="0,2,5,2"
                                          VerticalAlignment="Center"
                                        >
                                          <TextBlock
                                            Text="{Binding Text}"
                                            Foreground="{Binding Foreground}"
                                            FontSize="{Binding FontSize}"
                                            FontWeight="{Binding Weight}"
                                          />
                                        </Border>
                                      </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                  </ItemsControl>
                                  <TextBlock
                                    Grid.Column="1"
                                    Text="{Binding Action}"
                                    FontSize="13.5"
                                    TextWrapping="Wrap"
                                    VerticalAlignment="Center"
                                  />
                                </Grid>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <ItemsControl ItemsSource="{Binding Notes}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <TextBlock
                                  Text="{Binding}"
                                  Foreground="{StaticResource Muted}"
                                  FontSize="12.5"
                                  TextWrapping="Wrap"
                                  Margin="0,2"
                                />
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>

              <!-- Changes -->
              <DockPanel x:Name="ChangesView" Grid.Row="2" Margin="24,16,16,16" Visibility="Collapsed">
                <TextBlock
                  x:Name="PlanSummary"
                  DockPanel.Dock="Top"
                  Foreground="{StaticResource Muted}"
                  TextWrapping="Wrap"
                  Margin="0,0,0,10"
                />
                <ItemsControl x:Name="PlanErrors" DockPanel.Dock="Top" Margin="0,0,0,8">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="#3A1F1F" CornerRadius="6" Padding="10,6" Margin="0,0,0,4">
                        <TextBlock Text="{Binding}" Foreground="{StaticResource Bad}" TextWrapping="Wrap" />
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ListBox x:Name="PlanList">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="96" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                          CornerRadius="5"
                          Padding="7,2"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Top"
                          Background="{Binding BadgeBrush}"
                        >
                          <TextBlock Text="{Binding Action}" FontSize="11" FontWeight="Bold" Foreground="#120C02" />
                        </Border>
                        <StackPanel Grid.Column="1">
                          <TextBlock Text="{Binding Target}" TextTrimming="CharacterEllipsis" FontSize="13" />
                          <TextBlock
                            Text="{Binding Detail}"
                            Foreground="{StaticResource Muted}"
                            FontSize="11.5"
                            TextTrimming="CharacterEllipsis"
                            Visibility="{Binding DetailVisibility}"
                          />
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </DockPanel>

              <!-- License -->
              <ScrollViewer
                x:Name="LicenceView"
                Grid.Row="2"
                VerticalScrollBarVisibility="Auto"
                Padding="24,18,16,18"
                Visibility="Collapsed"
              >
                <TextBlock
                  x:Name="LicenceText"
                  Foreground="#E0E0E0"
                  TextWrapping="Wrap"
                  FontSize="13"
                  LineHeight="20"
                  MaxWidth="980"
                  HorizontalAlignment="Left"
                />
              </ScrollViewer>
            </Grid>
          </Border>

          <!-- Drop Zone: recessed panel with a large translucent logo in the background and the prompt and tagline in the centre. -->
          <Grid
            x:Name="EmptyState"
            Grid.Row="2"
            Margin="0,0,0,14"
            IsVisibleChanged="OnDropZoneVisible"
            DragEnter="OnDropZoneDragEnter"
            DragLeave="OnDropZoneDragLeave"
            Drop="OnDropZoneDragLeave"
            Background="Transparent"
          >
            <Border
              CornerRadius="18"
              Background="{StaticResource InsetFill}"
              BorderBrush="{StaticResource InsetEdge}"
              BorderThickness="1"
            />
            <Border CornerRadius="18" ClipToBounds="True" IsHitTestVisible="False">
              <Viewbox Stretch="Uniform" Margin="60,40" Opacity="0.025">
                <StackPanel Orientation="Horizontal">
                  <TextBlock
                    Text="{loc:Tr ui.main.mod}"
                    FontFamily="Arial Black, Arial"
                    FontWeight="Black"
                    FontSize="100"
                    Foreground="White"
                    VerticalAlignment="Center"
                    Margin="0,0,10,0"
                  />
                  <Border
                    Background="{StaticResource Accent}"
                    CornerRadius="14"
                    Padding="16,0,16,6"
                    VerticalAlignment="Center"
                  >
                    <TextBlock
                      Text="{loc:Tr ui.main.hub}"
                      FontFamily="Arial Black, Arial"
                      FontWeight="Black"
                      FontSize="100"
                      Foreground="Black"
                    />
                  </Border>
                </StackPanel>
              </Viewbox>
            </Border>
            <Rectangle
              x:Name="DropFrame"
              RadiusX="14"
              RadiusY="14"
              Margin="14"
              Stroke="#77736B"
              StrokeThickness="2"
              StrokeDashArray="3 5"
              IsHitTestVisible="False"
            />
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
              <Grid Width="78" Height="78" HorizontalAlignment="Center" Margin="0,0,0,18">
                <Ellipse Fill="#633C1D" Margin="0,3,0,-3" />
                <Ellipse
                  Fill="{StaticResource GlossOrange}"
                  Stroke="{StaticResource GlossOrangeEdge}"
                  StrokeThickness="1"
                />
                <Ellipse Margin="6,3,6,38" Fill="{StaticResource Sheen}" />
                <Path
                  Data="M 11,1 L 11,23 M 1,13 L 11,23 L 21,13"
                  Width="22"
                  Height="24"
                  Stroke="#1A1206"
                  StrokeThickness="4.5"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  StrokeLineJoin="Round"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Stretch="None"
                />
              </Grid>
              <TextBlock
                Text="{loc:Tr ui.main.dropModHere}"
                FontFamily="Bahnschrift, Segoe UI"
                FontWeight="Bold"
                FontSize="34"
                HorizontalAlignment="Center"
                Foreground="{StaticResource Text}"
              />
              <TextBlock
                Text="{loc:Tr ui.main.weLlDoAllDirty}"
                FontFamily="Bahnschrift, Segoe UI"
                FontSize="17"
                Foreground="{StaticResource AccentLight}"
                HorizontalAlignment="Center"
                Margin="0,4,0,0"
              />
              <Border
                HorizontalAlignment="Center"
                Margin="0,16,0,0"
                Padding="14,5"
                CornerRadius="12"
                Background="{StaticResource GlossDark}"
                BorderBrush="{StaticResource BevelEdge}"
                BorderThickness="1"
              >
                <TextBlock
                  Text="{loc:Tr ui.main.oivZipRar7z}"
                  FontFamily="Bahnschrift, Segoe UI"
                  FontSize="13"
                  Foreground="{StaticResource Muted}"
                />
              </Border>
              <TextBlock
                x:Name="DropTease"
                FontStyle="Italic"
                FontSize="14"
                Foreground="#E1B77D"
                HorizontalAlignment="Center"
                TextAlignment="Center"
                Margin="0,22,0,0"
                MaxWidth="560"
                TextWrapping="Wrap"
              />
              <TextBlock
                Text="{loc:Tr ui.main.packageAnalyzedFirstGameWill}"
                Foreground="#ADA9A2"
                FontSize="12"
                HorizontalAlignment="Center"
                Margin="0,8,0,0"
              />
            </StackPanel>
          </Grid>

          <DockPanel Grid.Row="3">
            <Button
              x:Name="InstallButton"
              DockPanel.Dock="Right"
              Content="{loc:Tr ui.main.apply}"
              Style="{StaticResource Primary}"
              IsEnabled="False"
              Click="OnInstall"
              MinWidth="170"
            />
            <TextBlock
              x:Name="StatusText"
              VerticalAlignment="Center"
              TextWrapping="Wrap"
              Foreground="{StaticResource Muted}"
              Margin="0,0,16,0"
            />
          </DockPanel>
        </Grid>

        <Border
          x:Name="BackgroundActivity"
          Grid.Column="1"
          Panel.ZIndex="40"
          HorizontalAlignment="Right"
          VerticalAlignment="Top"
          Margin="16,8,24,0"
          Padding="10,6"
          Background="{StaticResource Panel}"
          BorderBrush="{StaticResource Line}"
          BorderThickness="1"
          CornerRadius="8"
          Visibility="Collapsed"
          IsHitTestVisible="False"
        >
          <StackPanel Orientation="Horizontal">
            <ProgressBar
              Width="38"
              Height="3"
              IsIndeterminate="True"
              Foreground="{StaticResource Accent}"
              VerticalAlignment="Center"
              Margin="0,0,9,0"
            />
            <TextBlock
              x:Name="BackgroundActivityText"
              Foreground="{StaticResource Muted}"
              FontSize="11.5"
              MaxWidth="310"
              TextTrimming="CharacterEllipsis"
            />
          </StackPanel>
        </Border>
        <!-- Hotkeys -->
        <Grid x:Name="KeybindsHost" Grid.Column="1" Margin="24,20,24,16" Visibility="Collapsed">
          <kb:KeybindsPage x:Name="KeybindsView" />
        </Grid>
        <!-- Installation jobs: browser downloads and special files (.xml/.asi/.ini/.rpf) -->
        <Grid x:Name="FilesHost" Grid.Column="1" Visibility="Collapsed">
          <inst:InstallationPage x:Name="FilesView" />
        </Grid>
        <Grid x:Name="MyModsHost" Grid.Column="1" Visibility="Collapsed">
          <inv:MyModsPage x:Name="MyModsView" />
        </Grid>
        <Grid x:Name="AccessoriesHost" Grid.Column="1" Visibility="Collapsed">
          <ped:AccessoriesPage x:Name="AccessoriesView" />
        </Grid>
        <Grid x:Name="PedsHost" Grid.Column="1" Margin="24,20,12,16" Visibility="Collapsed">
          <ped:PedsPage x:Name="PedsView" />
        </Grid>

        <!-- Recommendations and the embedded browser -->
        <Grid x:Name="DiscoverHost" Grid.Column="1" Margin="24,20,8,0" Visibility="Collapsed">
          <dv:DiscoverPage x:Name="DiscoverView" />
        </Grid>
        <Grid x:Name="BrowserHost" Grid.Column="1" Visibility="Collapsed">
          <dv:BrowserView x:Name="BrowserView" />
        </Grid>

        <!-- History -->
        <Grid x:Name="HistoryPage" Grid.Column="1" Margin="24,20,24,16" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,16">
            <Button
              DockPanel.Dock="Right"
              Content="{loc:Tr ui.common.clearHistory}"
              Style="{StaticResource Ghost}"
              VerticalAlignment="Top"
              Click="OnClearHistory"
              ToolTip="{loc:Tr ui.main.deleteRecordsBackupsAllPast}"
            />
            <StackPanel>
              <TextBlock Text="{loc:Tr ui.main.packageActionHistory}" Style="{StaticResource PageTitle}" />
              <TextBlock
                Text="{loc:Tr ui.main.undoRestoresPreviousStateUsing}"
                Foreground="{StaticResource Muted}"
                Margin="0,3,0,0"
                TextWrapping="Wrap"
              />
            </StackPanel>
          </DockPanel>
          <ListBox x:Name="HistoryList" Grid.Row="1">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Background="{StaticResource Card}" CornerRadius="10" Padding="16,12" Margin="0,0,6,8">
                  <DockPanel>
                    <Button
                      DockPanel.Dock="Right"
                      Content="{loc:Tr ui.main.undoAction}"
                      Style="{StaticResource Ghost}"
                      Tag="{Binding Id}"
                      Click="OnUndo"
                      IsEnabled="{Binding CanUndo}"
                      VerticalAlignment="Center"
                    />
                    <StackPanel>
                      <TextBlock
                        Text="{Binding Title}"
                        FontSize="14"
                        FontWeight="SemiBold"
                        TextTrimming="CharacterEllipsis"
                      />
                      <TextBlock Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0">
                        <Run Text="{Binding When, Mode=OneWay}" />
                        <Run Text=" · " />
                        <Run Text="{Binding StateText, Mode=OneWay}" Foreground="{Binding StateBrush, Mode=OneWay}" />
                        <Run Text=" · " />
                        <Run Text="{Binding Files, Mode=OneWay}" />
                      </TextBlock>
                    </StackPanel>
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock x:Name="HistoryStatus" Grid.Row="2" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
        </Grid>

        <!-- First-run safety: until the base package is installed, installation is covered by this screen -->
        <bs:ReadinessGate x:Name="Gate" Grid.Column="1" Visibility="Collapsed" />

        <!-- Support the Author: shown after a mod from GTA5-Mods has been tried in game -->
        <Border
          x:Name="ThanksCard"
          Grid.Column="1"
          HorizontalAlignment="Right"
          VerticalAlignment="Bottom"
          Margin="0,0,24,20"
          Width="400"
          Background="{StaticResource SmokedGlass}"
          BorderBrush="{StaticResource SmokedEdge}"
          BorderThickness="1"
          CornerRadius="16"
          Padding="20,16"
          Visibility="Collapsed"
        >
          <StackPanel>
            <DockPanel>
              <Button
                DockPanel.Dock="Right"
                Content="✕"
                Style="{StaticResource Ghost}"
                Padding="8,2"
                Click="OnThanksLater"
                ToolTip="{loc:Tr ui.main.later}"
                VerticalAlignment="Top"
              />
              <TextBlock
                Text="{loc:Tr ui.main.supportAuthor}"
                Foreground="{StaticResource AccentLight}"
                FontSize="11"
                FontWeight="Bold"
                VerticalAlignment="Center"
              />
            </DockPanel>
            <TextBlock
              x:Name="ThanksTitle"
              FontFamily="Bahnschrift"
              FontWeight="SemiBold"
              FontSize="18"
              TextWrapping="Wrap"
              Margin="0,6,0,4"
            />
            <TextBlock
              Foreground="{StaticResource Muted}"
              TextWrapping="Wrap"
              FontSize="12.5"
              LineHeight="19"
              Text="{loc:Tr ui.main.modHubDownloadedModFrom}"
            />
            <WrapPanel Margin="0,12,0,0">
              <Button
                Content="{loc:Tr ui.common.openGta5Mods}"
                Style="{StaticResource Primary}"
                Click="OnThanksOpen"
                Margin="0,0,8,0"
              />
              <Button Content="{loc:Tr ui.main.donTRemindMe}" Style="{StaticResource Ghost}" Click="OnThanksNever" />
            </WrapPanel>
          </StackPanel>
        </Border>
      </Grid>

      <!-- Backups -->
      <ScrollViewer
        x:Name="BackupPage"
        Grid.Row="1"
        Margin="314,20,24,16"
        Visibility="Collapsed"
        VerticalScrollBarVisibility="Auto"
      >
        <StackPanel>
          <TextBlock Text="{loc:Tr ui.main.settings}" Style="{StaticResource PageTitle}" Margin="0,0,0,2" />
          <!-- Which build is running: date, time and commit (set by scripts\publish-portable.ps1). -->
          <TextBlock
            x:Name="BuildInfo"
            Foreground="{StaticResource Muted}"
            FontSize="12"
            Margin="2,0,0,14"
          />

          <Border Style="{StaticResource CardBorder}">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button
                  x:Name="UnassociateButton"
                  Content="{loc:Tr ui.main.unlink}"
                  Style="{StaticResource Ghost}"
                  Margin="0,0,8,0"
                  Click="OnUnassociate"
                />
                <Button
                  x:Name="AssociateButton"
                  Content="{loc:Tr ui.main.openOivFilesModhub}"
                  Style="{StaticResource Primary}"
                  Click="OnAssociate"
                />
              </StackPanel>
              <StackPanel Margin="0,0,16,0">
                <TextBlock
                  Text="{loc:Tr ui.main.openingOivPackages}"
                  FontFamily="Bahnschrift SemiBold, Bahnschrift, Segoe UI"
                  FontSize="17.5"
                />
                <TextBlock
                  x:Name="AssociationInfo"
                  Foreground="{StaticResource Muted}"
                  Margin="0,4,0,0"
                  TextWrapping="Wrap"
                />
              </StackPanel>
            </DockPanel>
          </Border>

          <TextBlock
            Text="{loc:Tr ui.common.backups}"
            FontFamily="Bahnschrift SemiBold, Bahnschrift, Segoe UI"
            FontSize="17.5"
            Margin="2,6,0,4"
          />
          <TextBlock
            Text="{loc:Tr ui.main.onlyFilesReplacedDeletedBy}"
            Foreground="{StaticResource Muted}"
            Margin="2,0,0,10"
          />
          <Border Style="{StaticResource CardBorder}">
            <StackPanel>
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                  <Button
                    x:Name="OpenBackupFolderButton"
                    Content="{loc:Tr ui.main.openFolder}"
                    Style="{StaticResource Ghost}"
                    Margin="0,0,8,0"
                    Click="OnOpenBackupFolder"
                  />
                  <Button
                    Content="{loc:Tr ui.main.configure}"
                    Style="{StaticResource Primary}"
                    Click="OnConfigureBackups"
                  />
                </StackPanel>
                <StackPanel>
                  <TextBlock
                    x:Name="BackupStatus"
                    FontFamily="Bahnschrift SemiBold, Bahnschrift, Segoe UI"
                    FontSize="17.5"
                  />
                  <TextBlock
                    x:Name="BackupPath"
                    Foreground="{StaticResource Muted}"
                    Margin="0,4,0,0"
                    TextWrapping="Wrap"
                  />
                </StackPanel>
              </DockPanel>
              <StackPanel x:Name="BackupUsagePanel" Margin="0,18,0,0">
                <Border
                  Height="12"
                  CornerRadius="6"
                  Background="{StaticResource InsetFill}"
                  BorderBrush="{StaticResource InsetEdge}"
                  BorderThickness="1"
                >
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition x:Name="UsedColumn" Width="0*" />
                      <ColumnDefinition x:Name="FreeColumn" Width="1*" />
                    </Grid.ColumnDefinitions>
                    <Border CornerRadius="5" Background="{StaticResource GlossOrange}" />
                  </Grid>
                </Border>
                <TextBlock x:Name="BackupUsage" Foreground="{StaticResource Muted}" Margin="0,8,0,0" />
                <Grid Margin="0,18,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Border
                    Background="{StaticResource InsetFill}"
                    BorderBrush="{StaticResource InsetEdge}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16,12"
                  >
                    <StackPanel>
                      <TextBlock Text="{loc:Tr ui.main.vanillaGameFiles}" FontWeight="SemiBold" />
                      <TextBlock
                        Text="{loc:Tr ui.main.rockstarOriginalsBeforeFirstChange}"
                        Foreground="{StaticResource Muted}"
                        FontSize="12"
                        Margin="0,3,0,8"
                        TextWrapping="Wrap"
                      />
                      <TextBlock
                        x:Name="VanillaSize"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource Ok}"
                      />
                    </StackPanel>
                  </Border>
                  <Border
                    Grid.Column="2"
                    Background="{StaticResource InsetFill}"
                    BorderBrush="{StaticResource InsetEdge}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16,12"
                  >
                    <StackPanel>
                      <TextBlock Text="{loc:Tr ui.main.modFiles}" FontWeight="SemiBold" />
                      <TextBlock
                        Text="{loc:Tr ui.main.fileVersionsInstalledByOther}"
                        Foreground="{StaticResource Muted}"
                        FontSize="12"
                        Margin="0,3,0,8"
                        TextWrapping="Wrap"
                      />
                      <TextBlock
                        x:Name="ModsSize"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource Accent}"
                      />
                    </StackPanel>
                  </Border>
                </Grid>
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource CardBorder}">
            <StackPanel>
              <TextBlock
                Text="{loc:Tr ui.main.downloadedArchives}"
                FontFamily="Bahnschrift SemiBold, Bahnschrift, Segoe UI"
                FontSize="17.5"
              />
              <CheckBox
                x:Name="ArchiveKeepCheck"
                Content="{loc:Tr ui.main.keepArchivesAfterSuccessfulInstallation}"
                Click="OnArchiveRetentionChanged"
                Margin="0,12,0,8"
              />
              <Button
                Content="{loc:Tr ui.main.selectArchiveFolder}"
                Style="{StaticResource Ghost}"
                Click="OnChooseArchiveLibrary"
                HorizontalAlignment="Left"
              />
              <TextBlock
                x:Name="ArchiveFolderInfo"
                Foreground="{StaticResource Muted}"
                TextWrapping="Wrap"
                Margin="0,8,0,0"
              />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource CardBorder}">
            <DockPanel>
              <Button
                DockPanel.Dock="Right"
                Content="{loc:Tr ui.common.clear}"
                Style="{StaticResource Ghost}"
                VerticalAlignment="Center"
                Click="OnClearDiscoverCache"
              />
              <StackPanel Margin="0,0,16,0">
                <TextBlock
                  Text="{loc:Tr ui.main.recommendationsCache}"
                  FontFamily="Bahnschrift SemiBold, Bahnschrift, Segoe UI"
                  FontSize="17.5"
                />
                <TextBlock
                  x:Name="DiscoverCacheInfo"
                  Foreground="{StaticResource Muted}"
                  Margin="0,4,0,0"
                  TextWrapping="Wrap"
                />
              </StackPanel>
            </DockPanel>
          </Border>

          <Border Style="{StaticResource CardBorder}">
            <DockPanel>
              <Button
                DockPanel.Dock="Right"
                Content="{loc:Tr ui.devDocs.open}"
                Style="{StaticResource Ghost}"
                VerticalAlignment="Center"
                Click="OnDeveloperGuide"
              />
              <StackPanel Margin="0,0,16,0">
                <TextBlock
                  Text="{loc:Tr ui.devDocs.title}"
                  FontFamily="Bahnschrift SemiBold, Bahnschrift, Segoe UI"
                  FontSize="17.5"
                />
                <TextBlock
                  Text="{loc:Tr ui.devDocs.cardText}"
                  Foreground="{StaticResource Muted}"
                  Margin="0,4,0,0"
                  TextWrapping="Wrap"
                />
              </StackPanel>
            </DockPanel>
          </Border>

          <Border Style="{StaticResource CardBorder}">
            <DockPanel>
              <Button
                DockPanel.Dock="Right"
                Content="{loc:Tr ui.uninstall.button}"
                Style="{StaticResource Ghost}"
                VerticalAlignment="Center"
                Click="OnUninstall"
              />
              <StackPanel Margin="0,0,16,0">
                <TextBlock
                  Text="{loc:Tr ui.uninstall.title}"
                  FontFamily="Bahnschrift SemiBold, Bahnschrift, Segoe UI"
                  FontSize="17.5"
                />
                <TextBlock
                  Text="{loc:Tr ui.uninstall.cardText}"
                  Foreground="{StaticResource Muted}"
                  Margin="0,4,0,0"
                  TextWrapping="Wrap"
                />
              </StackPanel>
            </DockPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- Progress overlay -->
      <Grid x:Name="BusyOverlay" Grid.RowSpan="2" Background="#CC0B0D10" Visibility="Collapsed">
        <Border
          Background="{StaticResource SmokedGlass}"
          BorderBrush="{StaticResource SmokedEdge}"
          BorderThickness="1"
          CornerRadius="16"
          Padding="28,22"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          MinWidth="460"
        >
          <StackPanel>
            <TextBlock x:Name="BusyTitle" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock
              x:Name="BusyActivity"
              FontSize="14"
              TextWrapping="Wrap"
              MaxWidth="760"
              Margin="0,10,0,0"
              Visibility="Collapsed"
            />
            <ProgressBar
              x:Name="BusyProgress"
              IsIndeterminate="True"
              Height="4"
              Margin="0,14,0,10"
              Foreground="{StaticResource Accent}"
              Background="#2B2E34"
              BorderThickness="0"
            />
            <TextBlock
              x:Name="BusyCounter"
              Foreground="{StaticResource Text}"
              Margin="0,0,0,8"
              Visibility="Collapsed"
            />
            <TextBlock x:Name="BusyText" Foreground="{StaticResource Muted}" TextWrapping="Wrap" MaxWidth="760" />
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>
