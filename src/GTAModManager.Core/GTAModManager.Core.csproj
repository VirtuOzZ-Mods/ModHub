<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SharpCompress" Version="0.50.9" />
  </ItemGroup>

  <ItemGroup>
    <!-- Recommendations catalog: the static declarative part (dynamic data lives in the cache). -->
    <EmbeddedResource Include="Discover\catalog.json" LogicalName="GTAModManager.Discover.catalog.json" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Localization\Languages\*.json" />
  </ItemGroup>
</Project>
